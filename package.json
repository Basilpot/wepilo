{
  "name": "wepilo",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev:api": "pnpm --filter @wepilo/api dev",
    "dev:dashboard": "pnpm --filter @wepilo/dashboard dev",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "deploy:api": "pnpm --filter @wepilo/api deploy:prod",
    "deploy:dashboard": "pnpm --filter @wepilo/dashboard deploy:prod"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
