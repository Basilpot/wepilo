---
import SplitHead from "./SplitHead.astro";

/** The problem, said plainly in the hero's split, with three numbers under a hairline. */
const costs = [
  { k: "~$250", unit: "/mo", v: "for a content agency, and your team still edits the drafts" },
  { k: "1", unit: "dev", v: "standing between you and each small change to the site" },
  { k: "Weeks", unit: "", v: "to translate a site for one new market" },
];
---

<section id="problem" class="scroll-mt-28 px-5 md:px-10 xl:px-[72px]" aria-labelledby="problem-title">
  <SplitHead
    id="problem-title"
    lead="A traveller who finds last year's departures on your Kilimanjaro page books with someone else. Most agencies know their site is behind, but fixing it means paying a content agency or waiting on a developer."
  >
    <Fragment slot="title">Old dates <em>cost you enquiries.</em></Fragment>
  </SplitHead>

  <dl class="reveal mt-16 grid border-t border-ink text-left md:mt-20 md:grid-cols-3">
    {
      costs.map((c, i) => (
        <div class:list={["border-b border-line py-8 md:border-b-0 md:py-10", i > 0 && "md:border-l md:pl-10", i < 2 && "md:pr-10"]}>
          <dt class="flex items-baseline gap-2 text-[clamp(3rem,2.3rem+2.2vw,4.5rem)] font-light leading-none tracking-[-0.05em] text-red">
            {c.k}
            {c.unit && <span class="font-mono text-[13px] tracking-normal text-muted">{c.unit}</span>}
          </dt>
          <dd class="mt-5 text-[15.5px] leading-[1.55] text-ink-2">{c.v}</dd>
        </div>
      ))
    }
  </dl>
</section>
