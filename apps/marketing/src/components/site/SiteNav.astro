---
import { LOGIN_URL, SETUP_CALL_URL, SIGNUP_URL } from "../../config";
import Button from "../ui/Button.astro";
import NavLink from "../ui/NavLink.astro";
import Glyph from "../sketch/Glyph.astro";
import type { GlyphName } from "../sketch/util";
import { features, featureBySlug } from "../../data/features";
import { solutions } from "../../data/solutions";
import { tintBg } from "../../lib/tints";

/**
 * The bar: wordmark, two mega menus (product, solutions), two plain links, then log in and the
 * two actions. Panels open on hover or click and close on Escape, outside click or focus leaving.
 */
interface Props {
  /**
   * Float the bar over the page's first section instead of the paper bar.
   * true: white glass on the cobalt hero. "light": pale glass with ink type, for painted scenes.
   */
  overlay?: boolean | "light";
}
const { overlay = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));

const featureGroups = [
  { label: "build", items: ["trip-pages", "departures", "languages"] },
  { label: "run", items: ["calendar", "roles-and-approvals", "ai-assistant", "enquiries"] },
  { label: "grow", items: ["seo", "website"] },
].map((g) => ({ ...g, items: g.items.map((s) => featureBySlug(s)!) }));

const solutionIcons: Record<string, GlyphName> = {
  "tour-operators": "calendar",
  "trekking-and-adventure": "route",
  "inbound-and-dmc": "globe",
};
const agencyTypes = [
  ...solutions.map((s) => ({ href: `/solutions/${s.slug}`, name: s.name, summary: s.summary, icon: solutionIcons[s.slug], tint: tintBg[s.tint] })),
  { href: "/developers", name: "Web developers", summary: "Build a client's site once and hand it over.", icon: "code" as GlyphName, tint: "bg-butter" },
];
const startHere: Array<{ href: string; name: string; summary: string; icon: GlyphName }> = [
  { href: "/pricing", name: "Pricing", summary: "One flat price for the whole agency.", icon: "price" },
  { href: SETUP_CALL_URL, name: "Book a setup call", summary: "Free with every paid plan.", icon: "calendar" },
  { href: "/#faq", name: "Common questions", summary: "Claude, enquiries, languages and more.", icon: "question" },
];

/** Glass on the hero sky; soft grey pills on the white pages. Same shapes either way. */
const dark = overlay === true;
const float = Boolean(overlay);
const pill = dark ? "glass text-white" : float ? "frost-pill text-ink" : "bg-mist text-ink";
/* The links pill holds the mega panels, so it must not use backdrop-filter: that would make it
   the panels' containing block and squeeze them to its width. Over flat sky the blur adds nothing. */
const linksPill = dark
  ? "bg-white/10 shadow-[inset_0_0_0_1px_rgb(255_255_255/0.06)] text-white"
  : float
    ? "bg-white/60 shadow-[inset_0_0_0_1px_rgb(255_255_255/0.7)] text-ink"
    : "bg-mist text-ink";
const trigger = dark
  ? "group inline-flex h-[39px] items-center gap-1.5 rounded-[7px] px-[18px] text-[17px] tracking-[0.005em] text-white transition-colors hover:bg-white/10 aria-expanded:bg-white/15 aria-[current=page]:bg-white/15"
  : "group inline-flex h-[39px] items-center gap-1.5 rounded-[7px] px-[18px] text-[17px] tracking-[0.005em] text-ink transition-colors hover:bg-black/5 aria-expanded:bg-white aria-expanded:shadow-[0_0_0_1px_rgb(13_13_13/0.08)] aria-[current=page]:bg-white aria-[current=page]:text-red aria-[current=page]:shadow-[0_0_0_1px_rgb(13_13_13/0.08)]";
const chevron = "size-3 opacity-60 transition-transform group-aria-expanded:rotate-180";
const panel = "absolute inset-x-0 top-full z-50 pt-2 motion-safe:animate-mega-in";
const card = "rounded-[12px] bg-white p-8 text-ink shadow-panel";
const colHead = "text-[13px] font-medium text-muted";
const item = "group/item -m-3 flex gap-4 rounded-[8px] p-3 transition-colors hover:bg-mist";
const tile = "grid size-11 shrink-0 place-items-center rounded-[8px] border border-ink/15";
const itemName = "block text-[15.5px] font-medium tracking-[-0.01em] text-ink group-hover/item:text-red";
const itemNote = "mt-0.5 block text-[14px] leading-[1.45] text-muted";
---

<header class:list={["z-40", float ? "absolute inset-x-0 top-0" : "relative bg-paper"]}>
  <nav aria-label="Main" class="flex h-[96px] items-center gap-4 px-5 md:h-[111px] md:px-10 md:pt-1 xl:px-[72px]">
    <a href="/" data-round class:list={["flex h-[47px] shrink-0 items-center gap-2 rounded-[8px] px-5 md:px-[26px]", pill]} aria-label="Wepilo, home">
      <svg viewBox="0 0 22 22" class="size-[22px]" aria-hidden="true">
        <defs><clipPath id="nav-mark"><circle cx="11" cy="11" r="11" /></clipPath></defs>
        <g clip-path="url(#nav-mark)" fill={dark ? "#fff" : "var(--color-cobalt)"}>
          <rect y="0" width="22" height="4.6" /><rect y="5.8" width="22" height="4.6" /><rect y="11.6" width="22" height="4.6" /><rect y="17.4" width="22" height="4.6" />
        </g>
      </svg>
      <span class="text-[20px] font-medium tracking-[-0.02em]">Wepilo</span>
    </a>

    <ul data-round class:list={["hidden h-[47px] items-center rounded-[8px] px-1 lg:flex", linksPill]}>
      <li data-mega>
        <button type="button" data-round class={trigger} aria-expanded="false" aria-controls="mega-features" aria-current={isCurrent("/product") ? "page" : undefined} data-mega-trigger>
          Product
          <svg viewBox="0 0 12 12" class={chevron} fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 4.5l3 3 3-3"></path></svg>
        </button>
        <div id="mega-features" class={panel} hidden data-mega-panel>
          <div class="wrap">
            <div class={card}>
              <div class="grid grid-cols-12 gap-8">
                {
                  featureGroups.map((g) => (
                    <div class="col-span-3">
                      <p class={colHead}>{g.label[0].toUpperCase() + g.label.slice(1)}</p>
                      <ul class="mt-6 space-y-6">
                        {g.items.map((f) => (
                          <li>
                            <a href={`/product/${f.slug}`} class={item}>
                              <span class:list={[tile, tintBg[f.tint]]}>
                                <Glyph name={f.icon} class="size-5" />
                              </span>
                              <span>
                                <span class={itemName}>{f.name}</span>
                                <span class={itemNote}>{f.summary}</span>
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))
                }
                <a href="/product/ai-assistant" class="group/promo relative col-span-3 flex min-h-[260px] flex-col justify-end overflow-hidden rounded-[8px] bg-cobalt p-6 text-white">
                  <img src="/video/cloud-sea.jpg" alt="" class="absolute inset-0 size-full object-cover opacity-80 transition-transform duration-500 group-hover/promo:scale-105" loading="lazy" />
                  <span class="absolute inset-0 bg-linear-to-t from-[#0f2a78]/90 via-[#0f2a78]/30 to-transparent" aria-hidden="true"></span>
                  <span class="relative text-[13px] font-medium text-white/75">AI assistant</span>
                  <span class="relative mt-3 text-[22px] leading-[1.15] tracking-[-0.025em]">Ask for next season's dates. Get a draft back.</span>
                  <span class="relative mt-4 text-[14px] text-white/85 transition-colors group-hover/promo:text-white">See how it works →</span>
                </a>
              </div>
              <div class="mt-8 flex items-center justify-between border-t border-line pt-5">
                <NavLink href="/product" class="text-[14px]">See the whole product</NavLink>
                <p class="text-[14px] text-muted">Every part is included in every plan</p>
              </div>
            </div>
          </div>
        </div>
      </li>

      <li data-mega>
        <button type="button" data-round class={trigger} aria-expanded="false" aria-controls="mega-solutions" aria-current={isCurrent("/solutions") ? "page" : undefined} data-mega-trigger>
          Solutions
          <svg viewBox="0 0 12 12" class={chevron} fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 4.5l3 3 3-3"></path></svg>
        </button>
        <div id="mega-solutions" class={panel} hidden data-mega-panel>
          <div class="wrap">
            <div class={card}>
              <div class="grid grid-cols-12 gap-8">
                <div class="col-span-6">
                  <p class={colHead}>By agency</p>
                  <ul class="mt-6 grid grid-cols-2 gap-x-8 gap-y-6">
                    {agencyTypes.map((a) => (
                      <li>
                        <a href={a.href} class={item}>
                          <span class:list={[tile, a.tint]}>
                            <Glyph name={a.icon} class="size-5" />
                          </span>
                          <span>
                            <span class={itemName}>{a.name}</span>
                            <span class={itemNote}>{a.summary}</span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="col-span-3">
                  <p class={colHead}>Start here</p>
                  <ul class="mt-6 space-y-6">
                    {startHere.map((a) => (
                      <li>
                        <a href={a.href} class={item}>
                          <span class:list={[tile, "bg-white"]}>
                            <Glyph name={a.icon} class="size-5" />
                          </span>
                          <span>
                            <span class={itemName}>{a.name}</span>
                            <span class={itemNote}>{a.summary}</span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
                <a href="/solutions" class="group/promo relative col-span-3 flex min-h-[260px] flex-col justify-end overflow-hidden rounded-[8px] bg-cobalt p-6 text-white">
                  <img src="/video/island.jpg" alt="" class="absolute inset-0 size-full object-cover opacity-85 transition-transform duration-500 group-hover/promo:scale-105" loading="lazy" />
                  <span class="absolute inset-0 bg-linear-to-t from-[#0f2a78]/90 via-[#0f2a78]/25 to-transparent" aria-hidden="true"></span>
                  <span class="relative text-[13px] font-medium text-white/75">Solutions</span>
                  <span class="relative mt-3 text-[22px] leading-[1.15] tracking-[-0.025em]">Treks, islands or tours: one way to publish.</span>
                  <span class="relative mt-4 text-[14px] text-white/85 transition-colors group-hover/promo:text-white">Find yours →</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </li>

      <li><a href="/pricing" data-round class={trigger} aria-current={isCurrent("/pricing") ? "page" : undefined}>Pricing</a></li>
      <li><a href="/developers" data-round class={trigger} aria-current={isCurrent("/developers") ? "page" : undefined}>Developers</a></li>
    </ul>

    <div class="ml-auto hidden items-center gap-3 md:flex">
      <a href={LOGIN_URL} data-round class:list={["inline-flex h-[47px] items-center rounded-[8px] px-5 text-[17px] transition-colors", pill, dark ? "hover:bg-white/15" : float ? "hover:bg-white/80" : "hover:bg-mist-2"]}>
        Sign in
      </a>
      {!dark && <Button href={SIGNUP_URL} variant="red" class="!h-[47px]">Start free trial</Button>}
    </div>

    <button
      type="button"
      data-round
      class:list={["ml-auto inline-flex h-[47px] items-center rounded-[8px] px-5 text-[17px] md:ml-0 lg:hidden", pill]}
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-toggle
    >
      Menu
    </button>
  </nav>

  <!-- Phones and tablets: the same groups, stacked. -->
  <div id="site-menu" data-menu hidden class="absolute inset-x-3 top-full max-h-[calc(100svh-110px)] overflow-y-auto rounded-[12px] bg-paper px-5 pb-6 pt-4 text-ink shadow-panel lg:hidden">
    <p class={colHead}>Product</p>
    <ul class="mt-3 grid gap-1 sm:grid-cols-2">
      {
        features.map((f) => (
          <li>
            <a href={`/product/${f.slug}`} class="flex items-center gap-3 py-2">
              <span class:list={["grid size-9 shrink-0 place-items-center rounded-[8px] border border-ink/15", tintBg[f.tint]]}>
                <Glyph name={f.icon} class="size-[18px]" />
              </span>
              <span class="text-[16px] font-medium">{f.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class:list={[colHead, "mt-6"]}>Solutions</p>
    <ul class="mt-3 grid gap-1 sm:grid-cols-2">
      {
        agencyTypes.map((a) => (
          <li>
            <a href={a.href} class="flex items-center gap-3 py-2">
              <span class:list={["grid size-9 shrink-0 place-items-center rounded-[8px] border border-ink/15", a.tint]}>
                <Glyph name={a.icon} class="size-[18px]" />
              </span>
              <span class="text-[16px] font-medium">{a.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-6 flex gap-6 border-t border-line pt-5">
      <NavLink href="/pricing">Pricing</NavLink>
      <NavLink href="/developers">Developers</NavLink>
      <NavLink href={LOGIN_URL}>Sign in</NavLink>
    </div>
    <div class="mt-6 grid gap-2 md:hidden">
      <Button href={SIGNUP_URL} variant="red" class="w-full">Start free trial</Button>
      <Button href={SETUP_CALL_URL} variant="light" class="w-full">Book a call</Button>
    </div>
  </div>
</header>
