---
import Shot from "./Shot.astro";

/** The travel data model, shown as the fields a trip actually has, beside the site features that support it. */
const types = [
  ["Destinations and regions", "Linked to every trip that visits them."],
  ["Pages and blog posts", "About, contact, the journal."],
  ["Team and guides", "The people travellers will walk with."],
  ["Reviews", "Entered by hand or imported."],
];
---

<section class="relative pt-40 md:pt-56" aria-labelledby="schema-title">
  <div class="wrap">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="reveal md:col-span-5">
        <p class="label">Built for travel</p>
        <h2 id="schema-title" class="serif mt-6 text-section">A trip is not a blog post.</h2>
        <p class="mt-8 max-w-[34rem] text-lead text-ink-2">
          Generic CMSs make you design your own trip structure. Wepilo ships with one: the fields a travel site needs,
          ready the day you sign up.
        </p>
        <ul class="mt-12 divide-y divide-line border-y border-line">
          {
            types.map(([k, v]) => (
              <li class="flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                <span class="text-[17px] font-semibold">{k}</span>
                <span class="text-[15px] text-muted">{v}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="reveal relative md:col-span-7">
        <div class="glow -right-10 -top-10 size-80 bg-saffron/40" aria-hidden="true"></div>
        <div class="glow -bottom-10 left-0 size-72 bg-glacier/30" aria-hidden="true"></div>
        <Shot
          src="/product/ed-faq.webp"
          alt="The trip editor's outline: the trip, itinerary, photos and map, what's included, practical details, price and extras, and before booking, with the FAQ step open and three questions answered."
          class="relative"
        />
      </div>
    </div>

  </div>
</section>
