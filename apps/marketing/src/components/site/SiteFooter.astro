---
import Button from "../ui/Button.astro";
import { CONTACT_EMAIL, LOGIN_URL, SETUP_CALL_URL, SIGNUP_URL } from "../../config";

import { solutions } from "../../data/solutions";

/** The hero, bookended: cobalt sky, closing line and a white button, the range, then a standard link grid. */
const columns = [
  {
    title: "Product",
    links: [
      { label: "Overview", href: "/product" },
      { label: "Pricing", href: "/pricing" },
      { label: "Developers", href: "/developers" },
      { label: "FAQ", href: "/#faq" },
    ],
  },
  {
    title: "Solutions",
    links: [...solutions.map((s) => ({ label: s.name, href: `/solutions/${s.slug}` })), { label: "Web developers", href: "/developers" }],
  },
  {
    title: "Get started",
    links: [
      { label: "Start free trial", href: SIGNUP_URL },
      { label: "Book a setup call", href: SETUP_CALL_URL },
      { label: "Log in", href: LOGIN_URL },
      { label: "Contact", href: `mailto:${CONTACT_EMAIL}` },
    ],
  },
];
---

<footer class="sky relative mt-36 isolate overflow-hidden text-white md:mt-56">
  <div class="grain pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  <!-- Closing: headline left, lead and the white button right, as in the hero. -->
  <section class="relative grid gap-10 px-5 pt-24 md:grid-cols-[1fr_minmax(0,29rem)] md:gap-16 md:px-10 md:pt-32 xl:grid-cols-[1fr_32rem] xl:px-[72px]" aria-labelledby="closing-title">
    <div>
      <p class="text-[15px] text-white/75">$50 a month or $499 a year, for the whole agency</p>
      <h2 id="closing-title" class="mt-6 max-w-[15em] text-[clamp(2.25rem,1.4rem+2.8vw,3.5rem)] font-light leading-[1.1] tracking-[-0.045em] text-[#e6ecff]">
        Let's get your site up to date.
      </h2>
    </div>
    <div class="md:pt-4">
      <p class="text-[clamp(1.0625rem,0.95rem+0.45vw,1.4rem)] leading-[1.3] text-white/70">
        Every paid plan starts with a free setup call, so your team isn't left to work it out alone.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <Button href={SETUP_CALL_URL} variant="light" class="!shadow-none">Book a setup call</Button>
        <a href="/pricing" data-round class="glass inline-flex h-[50px] items-center rounded-[8px] px-6 text-[17px] font-medium text-white transition-colors hover:bg-white/20">See pricing</a>
      </div>
    </div>
  </section>

  <!-- The range from the hero, rising behind the links. -->
  <div class="relative mt-16 md:mt-10">
    <img src="/art/hero-mountains.webp" alt="" width="2400" height="1100" loading="lazy" class="pointer-events-none relative left-1/2 -z-10 h-auto w-full min-w-[1100px] max-w-none -translate-x-1/2 select-none" />
    <div class="absolute inset-x-0 bottom-0 z-10">
      <div class="footer-pane px-5 md:px-10 xl:px-[72px]">
        <div class="grid gap-10 py-12 md:grid-cols-[1.4fr_repeat(3,1fr)] md:gap-8 md:py-14">
          <div>
            <a href="/" class="inline-flex items-center gap-2 text-[22px] font-medium tracking-[-0.02em] text-ink">
              <svg viewBox="0 0 22 22" class="size-[22px]" aria-hidden="true">
                <defs><clipPath id="foot-mark"><circle cx="11" cy="11" r="11" /></clipPath></defs>
                <g clip-path="url(#foot-mark)" fill="var(--color-cobalt)"><rect y="0" width="22" height="4.6" /><rect y="5.8" width="22" height="4.6" /><rect y="11.6" width="22" height="4.6" /><rect y="17.4" width="22" height="4.6" /></g>
              </svg>
              Wepilo
            </a>
            <p class="mt-3 max-w-[26ch] text-[15px] leading-[1.5] text-ink-2/80">Website software for travel and tour agencies.</p>
          </div>
          {
            columns.map((c) => (
              <nav aria-label={c.title}>
                <p class="text-[13px] font-medium text-ink-2/60">{c.title}</p>
                <ul class="mt-4 space-y-2.5">
                  {c.links.map((l) => (
                    <li>
                      <a href={l.href} class="text-[15px] text-ink transition-colors hover:text-red">{l.label}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            ))
          }
        </div>
        <div class="flex flex-col gap-2 border-t border-ink/10 py-5 text-[13px] text-ink-2/70 sm:flex-row sm:items-center sm:justify-between">
          <span>© {new Date().getFullYear()} Wepilo</span>
          <a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-red">{CONTACT_EMAIL}</a>
        </div>
      </div>
    </div>
  </div>
</footer>
