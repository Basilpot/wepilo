  mountain: [
    "................",
    "................",
    "........#.......",
    ".......#.#......",
    "......#.#.#.....",
    ".....#.....#....",
    "....#.......#...",
    "...#....#....#..",
    "..#....#.#....#.",
    ".#....#...#....#",
    "#....#.....#...#",
    "################",
  ],
  flag: [
    "..#.............",
    "..##########....",
    "..#.........#...",
    "..#..........#..",
    "..#.........#...",
    "..##########....",
    "..#.............",
    "..#.............",
    "..#.............",
    "..#.............",
    "..#.............",
    ".###............",
  ],
  pin: [
    ".....######.....",
    "....#......#....",
    "...#........#...",
    "...#...##...#...",
    "...#..#..#..#...",
    "...#...##...#...",
    "....#......#....",
    ".....#....#.....",
    "......#..#......",
    ".......##.......",
    "................",
    "....########....",
  ],
  binoculars: [
    "..####....####..",
    "..#..#....#..#..",
    "..#..######..#..",
    ".#....#..#....#.",
    "#......##......#",
    "#..##..##..##..#",
    "#.#..#.##.#..#.#",
    "#.#..#.##.#..#.#",
    "#..##..##..##..#",
    ".#....#..#....#.",
    "..####....####..",
    "................",
  ],
  stupa: [
    ".......##.......",
    ".......##.......",
    "......####......",
    ".......##.......",
    "......####......",
    ".....#.##.#.....",
    "....#......#....",
    "...#........#...",
    "..#..........#..",
    "..############..",
    ".#............#.",
    "################",
  ],
  wave: [
    "................",
    "........##......",
    ".......#..#.....",
    "......#....#....",
    "#....#......#...",
    ".#..#........#..",
    "..##..........##",
    "................",
    "##....##....##..",
    "..#..#..#..#..#.",
    "...##....##....#",
    "................",
  ],
  globe: [
    ".....######.....",
    "...##..##..##...",
    "..#...#..#...#..",
    ".#...#....#...#.",
