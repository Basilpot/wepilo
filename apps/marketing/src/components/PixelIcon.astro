    "................",
  ],
  ledger: [
    "..############..",
    "..#..........#..",
    "..#.##.#####.#..",
    "..#..........#..",
    "..#.##.#####.#..",
    "..#..........#..",
    "..#.##.####..#..",
    "..#..........#..",
    "..#.##.###...#..",
    "..#..........#..",
    "..############..",
    "................",
  ],
  stack: [
    "......####......",
    "....##....##....",
    "..##........##..",
    "....##....##....",
    "..#...####...#..",
    "...##......##...",
    "..#..##..##..#..",
    "...##..##..##...",
    "..#...#..#...#..",
    "....##....##....",
    "......####......",
    "................",
  ],
} as const;

export type PixelName = keyof typeof art;

interface Props {
  name: PixelName;
  class?: string;
}

const { name, class: className } = Astro.props;
const rows = art[name];
const w = rows[0].length;
const h = rows.length;
const pixels: Array<[number, number]> = [];
rows.forEach((row, y) => [...row].forEach((c, x) => c === "#" && pixels.push([x, y])));
---

<svg viewBox={`0 0 ${w + 1} ${h + 1}`} class={className} shape-rendering="crispEdges" aria-hidden="true">
  <g fill="var(--color-line-strong)" transform="translate(1 1)">
    {pixels.map(([x, y]) => <rect x={x} y={y} width="1" height="1" />)}
  </g>
  <g fill="var(--color-ink)">
    {pixels.map(([x, y]) => <rect x={x} y={y} width="1" height="1" />)}
  </g>
</svg>
