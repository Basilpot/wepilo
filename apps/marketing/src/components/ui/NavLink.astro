---
/** A plain text link with a thin underline that firms up on hover. The current page, and hover, go cobalt. */
interface Props {
  href: string;
  current?: boolean;
  /** Cobalt at rest (footer style), ink on hover. */
  red?: boolean;
  class?: string;
}
const { href, current = false, red = false, class: cls } = Astro.props;
---

<a
  href={href}
  aria-current={current ? "page" : undefined}
  class:list={[
    "inline-block text-[15px] underline decoration-current/30 decoration-1 underline-offset-[5px] transition-colors duration-150 first-letter:uppercase hover:decoration-current",
    red ? "text-red hover:text-ink" : "text-ink hover:text-red aria-[current=page]:text-red",
    cls,
  ]}><slot /></a
>
