---
/**
 * The site's button, cut from the hero: flat fill, 8px corners, medium weight, sentence case.
 * The first letter is capitalised for you, so callers can pass lowercase copy.
 */
interface Props {
  href: string;
  /** red: the one main action (hero cobalt). dark: ink. light: white key with a hairline, readable anywhere. */
  variant?: "red" | "dark" | "light";
  size?: "md" | "sm";
  class?: string;
}
const { href, variant = "dark", size = "md", class: cls } = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-[8px] font-sans font-medium tracking-[-0.01em] transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-red";
const sizes = {
  md: "h-[50px] px-6 text-[17px]",
  sm: "h-10 px-4 text-[15px]",
};
const variants = {
  red: "bg-cobalt text-white hover:bg-cobalt-deep",
  dark: "bg-ink text-white hover:bg-[#2a2a2a]",
  light: "bg-white text-[#111] shadow-[inset_0_0_0_1px_rgb(13_13_13/0.14)] hover:bg-[#eef1fb] hover:shadow-[inset_0_0_0_1px_rgb(34_82_216/0.35)]",
};
---

<a href={href} data-round class:list={[base, sizes[size], variants[variant], cls]}><span class="inline-block first-letter:uppercase"><slot /></span></a>
