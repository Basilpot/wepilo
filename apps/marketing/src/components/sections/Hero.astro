---
interface Props {
  dashboard: string;
}

const { dashboard } = Astro.props;
---

<section class="pt-14 sm:pt-24">
  <div class="shell text-center">
    <a
      href="#ai"
      class="inline-flex items-center gap-2 rounded-pill border border-line bg-surface py-1 pl-1 pr-3 text-[13px] text-muted transition-colors hover:border-[#d4d4d8] hover:text-ink"
    >
      <span class="rounded-pill bg-[#eaf1ff] px-2 py-0.5 font-medium text-accent">New</span>
      Run your agency from Claude, Cursor or ChatGPT
      <svg viewBox="0 0 16 16" class="size-3" fill="none" aria-hidden="true">
        <path d="M6 3.5 10.5 8 6 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>

    <h1 class="mx-auto mt-7 max-w-[15ch] text-display">Your travel agency, run from one place</h1>
    <p class="mx-auto mt-6 max-w-[40rem] text-lead text-muted">
      Trips, departures, bookings and enquiries in one dashboard. Published to your website through one API, and open
      to the AI tools your team already uses.
    </p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a href={`${dashboard}/signup`} class="btn btn-dark btn-lg">Get started free</a>
      <a href="#talk" class="btn btn-light btn-lg">Book a demo</a>
    </div>
  </div>

  <div class="shell mt-14 sm:mt-20">
    <div class="mesh rounded-[28px] px-4 pt-10 sm:px-12 sm:pt-16 lg:px-20">
      <div class="relative">
        <img
          src="/shots/dashboard.png"
          alt="The Wepilo dashboard, showing a travel agency's trips, bookings and enquiries."
          width="1440"
          height="900"
          loading="eager"
          decoding="async"
          class="shot block w-full rounded-b-none"
        />

        <div class="float-card absolute -left-3 top-12 hidden w-[15.5rem] sm:block lg:-left-12">
          <p class="flex items-center gap-2 text-[13px] font-medium">
            <span class="size-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
            Booking confirmed
          </p>
          <p class="mt-1.5 text-[13px] leading-5 text-muted">Everest Base Camp · 2 travellers · 10 Nov</p>
          <p class="mt-3 font-mono text-[11px] text-faint">seats taken · deposit paid</p>
        </div>

        <div class="float-card absolute -right-3 top-[45%] hidden w-[15.5rem] sm:block lg:-right-12">
          <p class="flex items-center gap-2 text-[13px] font-medium">
            <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
            New enquiry
          </p>
          <p class="mt-1.5 text-[13px] leading-5 text-muted">“Is the Annapurna departure in March still open for two?”</p>
          <p class="mt-3 font-mono text-[11px] text-faint">from your website</p>
        </div>
      </div>
    </div>
  </div>
</section>
