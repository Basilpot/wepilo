---
/**
 * The same desk, set up for different kinds of trip. Each tab pairs what the agency gets
 * with something it might ask its assistant, and what comes back.
 */
type Row = { label: string; value: string; tone?: "ok" | "warn" | "muted" };
type Kind = {
  id: string;
  label: string;
  headline: string;
  points: string[];
  ask: string;
  result: { eyebrow: string; title: string; rows: Row[]; note: string };
};

const kinds: Kind[] = [
  {
    id: "trekking",
    label: "Trekking",
    headline: "Twelve seats, fourteen days and a porter for every two trekkers",
    points: [
      "Day-by-day itineraries with an altitude chart and the lodges on the way",
      "Seats on every departure, so a full group closes itself",
      "Extras like porters or gear hire, priced per traveller",
    ],
    ask: "Which spring departures still have room, and how many seats are left on each?",
    result: {
      eyebrow: "Departures · spring",
      title: "Everest Base Camp Trek",
      rows: [
        { label: "Mar 22", value: "Full", tone: "muted" },
        { label: "Apr 5", value: "4 seats left", tone: "ok" },
        { label: "Apr 19", value: "2 seats left", tone: "warn" },
        { label: "May 3", value: "11 seats left", tone: "ok" },
      ],
      note: "Two pending requests on Apr 19. Confirming both would close it.",
    },
  },
  {
    id: "operators",
    label: "Tour operators",
    headline: "One catalogue, read by every website you run",
    points: [
      "A workspace per brand, all under one login",
      "Each site asks the same API for its own trips",
      "Roles for owners, managers and editors",
    ],
    ask: "Summarise today across all three brands.",
    result: {
      eyebrow: "Today · 3 workspaces",
      title: "What needs you",
      rows: [
        { label: "Brand one", value: "2 bookings to confirm", tone: "warn" },
        { label: "Brand two", value: "1 new enquiry", tone: "ok" },
        { label: "Brand three", value: "Nothing waiting", tone: "muted" },
      ],
      note: "The next departure leaves Nov 28 with 8 of 12 seats booked.",
    },
  },
  {
    id: "safari",
    label: "Wildlife safaris",
    headline: "Requests in, you confirm, you settle the details",
    points: [
      "Every booking arrives as a reservation request",
      "You confirm it, then agree payment with the traveller",
      "Status on every booking: pending, confirmed, completed",
    ],
    ask: "Which Chitwan departures in February still have requests to confirm?",
    result: {
      eyebrow: "Requests · February",
      title: "Chitwan Jungle Safari",
      rows: [
        { label: "Sample request A", value: "2 travellers, pending", tone: "warn" },
        { label: "Sample request B", value: "Confirmed", tone: "ok" },
        { label: "Sample request C", value: "4 travellers, pending", tone: "warn" },
      ],
      note: "I can draft a reply to each pending request. You send it.",
    },
  },
  {
    id: "day-tours",
    label: "Day tours",
    headline: "Rafting on Tuesday, a cooking class on Thursday",
    points: [
      "A simple page for short trips and day tours",
      "Enquiries tagged with the tour they are about",
      "Posts and pages for the stories behind each tour",
    ],
    ask: "Draft a post about our new Trishuli rafting day for the journal.",
    result: {
      eyebrow: "Draft post",
      title: "A day on the Trishuli",
      rows: [
        { label: "Status", value: "Draft, hidden", tone: "muted" },
        { label: "Category", value: "Journal", tone: "ok" },
        { label: "Length", value: "640 words", tone: "muted" },
      ],
      note: "Saved as a draft. Add a photo and publish it from Wepilo when it reads right.",
    },
  },
];

const tone = { ok: "bg-[#e6f4ea] text-[#1f7a3a]", warn: "bg-[#fdf0e6] text-[#b4531d]", muted: "bg-paper-2 text-muted" };
---

<section id="by-trip" class="rule">
  <div class="shell py-28 sm:py-36" data-tabs>
    <h2 class="reveal max-w-[22ch] text-section">Built around the trips <span class="serif">you actually sell.</span></h2>

    <div class="reveal mt-12 flex gap-8 overflow-x-auto border-b border-line" role="tablist" aria-label="Kinds of trip">
      {
        kinds.map((k, i) => (
          <button
            type="button"
            role="tab"
            id={`kind-tab-${i}`}
            aria-controls={`kind-panel-${i}`}
            aria-selected={i === 0 ? "true" : "false"}
            data-tab={i}
            class="kind-tab shrink-0 pb-4 font-mono text-[13px]"
          >
            {k.label}
          </button>
        ))
      }
    </div>

    {
      kinds.map((k, i) => (
        <div
          id={`kind-panel-${i}`}
          role="tabpanel"
          aria-labelledby={`kind-tab-${i}`}
          data-panel={i}
          class:list={["mt-10 grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.95fr)]", i !== 0 && "hidden"]}
        >
          <div class="border border-line bg-card p-7 sm:p-12">
            <h3 class="max-w-[22ch] text-[clamp(1.5rem,1.1rem+1.2vw,2rem)] leading-[1.15] tracking-[-0.025em]">{k.headline}</h3>
            <ul class="mt-12 divide-y divide-line">
              {k.points.map((p) => (
                <li class="flex gap-4 py-5 text-[17px] leading-7 text-ink-2">
                  <span class="mt-[11px] size-[7px] shrink-0 bg-flag" aria-hidden="true" />
                  {p}
                </li>
              ))}
            </ul>
          </div>

          <div class="art art-haze flex flex-col justify-center gap-0 border border-line px-5 py-12 sm:px-12">
            <p class="ml-auto max-w-[26rem] rounded-[14px] bg-white/70 px-5 py-4 text-[15px] leading-6 ring-1 ring-white backdrop-blur-md">
              {k.ask}
            </p>
            <div class="mr-auto ml-10 h-8 w-px bg-white/90" aria-hidden="true" />
            <div class="rounded-[12px] bg-card p-5 shadow-[0_30px_60px_-34px_rgb(30_40_70/0.5)] ring-1 ring-black/5 sm:p-6">
              <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">{k.result.eyebrow}</p>
              <p class="mt-3 text-[1.25rem] tracking-[-0.02em]">{k.result.title}</p>
              <dl class="mt-4 divide-y divide-line border-y border-line">
                {k.result.rows.map((r) => (
                  <div class="flex items-center justify-between gap-4 py-2.5 text-[14px]">
                    <dt class="text-ink-2">{r.label}</dt>
                    <dd class={`rounded-[5px] px-2 py-0.5 font-mono text-[11.5px] ${tone[r.tone ?? "muted"]}`}>{r.value}</dd>
                  </div>
                ))}
              </dl>
              <p class="mt-4 text-[14px] leading-6 text-muted">{k.result.note}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
