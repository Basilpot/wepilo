---
interface Props {
  dashboard: string;
}

const { dashboard } = Astro.props;
---

<section>
  <div>
    <div class="art art-hero bleed px-6 pb-[clamp(15rem,30vw,25rem)] pt-16 text-center sm:pt-28">
      <p
        class="mx-auto inline-flex items-center gap-2 rounded-[7px] bg-white/15 px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.08em] text-white ring-1 ring-white/30 backdrop-blur-md"
      >
        <span class="size-[6px] shrink-0 bg-flag" aria-hidden="true"></span>
        For trekking companies, tour operators and travel agencies
      </p>

      <h1 class="mx-auto mt-7 max-w-[13ch] text-display text-white">
        Sell more trips. <span class="serif">Chase fewer tabs.</span>
      </h1>

      <p class="mx-auto mt-6 max-w-[36rem] text-lead text-white/85">
        Wepilo keeps your trips, dates, bookings and enquiries in one place, puts them on your website, and lets your
        AI assistant take the busywork.
      </p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a href={`${dashboard}/signup`} class="btn btn-light">Try it for $1</a>
        <a href="#talk" class="btn btn-dark">Book a demo</a>
      </div>
      <p class="mt-4 text-[13px] text-white/75">Three days for a dollar. Nothing renews by itself.</p>
    </div>
  </div>

  <!-- The product, rising out of the foothills. -->
  <div class="shell relative z-10 -mt-14 sm:-mt-20">
    <div class="relative mx-auto max-w-[1040px]">
      <img
        src="/shots/dashboard.png"
        alt="The Wepilo dashboard: what needs attention today, the setup checklist, and this week's bookings and enquiries."
        width="1440"
        height="900"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="shot block w-full"
      />

      <div
        class="absolute -left-2 top-20 hidden w-[15.5rem] rounded-[10px] bg-white/95 p-4 shadow-[0_24px_50px_-24px_rgb(13_24_48/0.5)] ring-1 ring-black/5 backdrop-blur-md md:block lg:-left-20"
      >
        <p class="flex items-center gap-2 text-[13px] font-medium">
          <span class="size-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
          Booking request
        </p>
        <p class="mt-1.5 text-[13px] leading-5 text-muted">Everest Base Camp · 2 travellers · 10 Nov</p>
        <p class="mt-3 font-mono text-[11px] text-faint">2 seats held · you confirm</p>
      </div>

      <div
        class="absolute -right-2 bottom-24 hidden w-[15.5rem] rounded-[10px] bg-white/95 p-4 shadow-[0_24px_50px_-24px_rgb(13_24_48/0.5)] ring-1 ring-black/5 backdrop-blur-md md:block lg:-right-20"
      >
        <p class="flex items-center gap-2 text-[13px] font-medium">
          <span class="size-1.5 rounded-full bg-sky" aria-hidden="true"></span>
          New enquiry
        </p>
        <p class="mt-1.5 text-[13px] leading-5 text-muted">“Is the March Annapurna departure still open for two?”</p>
        <p class="mt-3 font-mono text-[11px] text-faint">from your website</p>
      </div>
    </div>
  </div>
</section>
