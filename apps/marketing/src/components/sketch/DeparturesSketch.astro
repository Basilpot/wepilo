---
import SketchFrame from "./SketchFrame.astro";
import type { Callout } from "./util";

/** Departures: dates, seats and prices for one trip, with a question about a date on top. */
interface Props {
  annotated?: boolean;
}
const { annotated = false } = Astro.props;

const rows: Array<[string, number, string, "open" | "full"]> = [
  ["12 jan 2027", 4, "$2,150", "open"],
  ["02 feb 2027", 0, "$2,150", "full"],
  ["16 mar 2027", 9, "$2,250", "open"],
  ["06 apr 2027", 12, "$2,250", "open"],
  ["11 may 2027", 7, "$2,190", "open"],
];

const callouts: Callout[] = [
  { at: [300, 160], to: [262, 170], side: "left", lines: ["dates, seats and price", "for every departure"] },
  { at: [840, 214], to: [940, 150], side: "right", lines: ["full dates", "stand out"] },
  { at: [920, 440], to: [940, 520], side: "right", lines: ["date questions arrive", "by email; you book", "them your own way"] },
];
---

<SketchFrame title="A list of departures with seats left and prices, and a question about a date arriving by email." callouts={callouts} annotated={annotated}>
  <rect x="300" y="60" width="600" height="380" class="w" />
  <text x="318" y="83" class="m">departures · kilimanjaro, machame route</text>
  <line x1="300" y1="96" x2="900" y2="96" />
  <text x="320" y="122" class="m">date</text>
  <text x="470" y="122" class="m">seats left</text>
  <text x="650" y="122" class="m">price</text>
  <text x="782" y="122" class="m">status</text>
  <line x1="300" y1="132" x2="900" y2="132" class="g" />
  {
    rows.map(([date, left, price, status], i) => {
      const y = 164 + i * 50;
      return (
        <g>
          <text x="320" y={y + 4} style="font-size:13px">{date}</text>
          {Array.from({ length: 12 }).map((_, j) => (
            <rect x={470 + j * 12} y={y - 6} width="9" height="9" class={j < left ? "k" : "w"} />
          ))}
          <text x="650" y={y + 4} style="font-size:13px">{price}</text>
          <rect x="782" y={y - 10} width="58" height="20" class={status === "full" ? "k" : "w"} />
          <text x="811" y={y + 4} text-anchor="middle" class="m" style={status === "full" ? "fill:#fff" : ""}>{status}</text>
          {i < rows.length - 1 && <line x1="300" y1={y + 25} x2="900" y2={y + 25} class="g" />}
        </g>
      );
    })
  }

  <!-- The request, as it lands in the agency's email. -->
  <rect x="620" y="370" width="300" height="190" class="w" />
  <rect x="636" y="388" width="7" height="7" class="r" />
  <text x="650" y="395" class="m">your email · 2m ago</text>
  <line x1="620" y1="406" x2="920" y2="406" />
  <text x="636" y="432" class="s">Question about a date</text>
  <text x="636" y="456" style="font-size:12.5px">Kilimanjaro, Machame Route</text>
  <text x="636" y="476" class="m">12 jan 2027 · 2 travellers · from $2,150</text>
  <text x="636" y="496" class="m">sofia martín · sofia@example.es</text>
  <rect x="636" y="514" width="100" height="28" class="k" />
  <text x="686" y="533" text-anchor="middle" class="m" style="fill:#fff">reply</text>
</SketchFrame>
