---
import Glyph from "./Glyph.astro";
import type { GlyphName } from "./util";

/**
 * Numbered benefits as frosted cards. On a painted band (`scene`) they sit on the landscape's
 * foreground; on white they get a quiet mist fill.
 */
interface Props {
  items: Array<{ icon: GlyphName; title: string; body: string }>;
  label?: string;
  /** Sitting on a painted scene: frosted glass, no outer gutter (the band supplies it). */
  scene?: boolean;
}
const { items, label, scene = false } = Astro.props;
const n = items.length;
const cols = n === 4 ? "md:grid-cols-2 lg:grid-cols-4" : "md:grid-cols-3";
---

<section class:list={[!scene && "px-5 md:px-10 xl:px-[72px]"]} aria-label={label}>
  <ol class:list={["grid gap-3", cols]}>
    {
      items.map((p) => (
        <li class:list={["flex flex-col rounded-[8px] p-7 md:p-8", scene ? "frost" : "bg-mist"]}>
          <div>
            <span class="grid size-11 place-items-center rounded-[8px] bg-white text-red shadow-[inset_0_0_0_1px_rgb(13_13_13/0.08)]">
              <Glyph name={p.icon} class="size-[22px]" />
            </span>
          </div>
          <h3 class="mt-10 text-[clamp(1.375rem,1.25rem+0.5vw,1.75rem)] font-light leading-[1.15] tracking-[-0.035em]">{p.title}</h3>
          <p class="mt-3 max-w-[36ch] text-[16px] leading-[1.55] text-ink-2">{p.body}</p>
        </li>
      ))
    }
  </ol>
</section>
