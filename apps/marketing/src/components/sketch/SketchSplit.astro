---
import { tintBg } from "../../lib/tints";
import Button from "../ui/Button.astro";
import type { Feature } from "../../data/features";
import Sketch from "./Sketch.astro";
import Glyph from "./Glyph.astro";

/**
 * The quieter partner to SketchBlock: words on one side, the drawing on a ruled panel on the other.
 * Alternating the two down the homepage keeps the rhythm from going flat.
 */
interface Props {
  feature: Feature;
  /** "02 / 04" style counter. */
  count: string;
  /** Put the drawing on the left. */
  flip?: boolean;
  id: string;
  class?: string;
}
const { feature: f, count, flip = false, id, class: cls } = Astro.props;
---

<section class:list={["wrap", cls]} aria-labelledby={id}>
  <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class:list={["reveal lg:col-span-5", flip && "lg:order-2"]}>
      <p class="flex items-center gap-3 font-mono text-[12.5px] lowercase text-muted">
        <span class="size-2 bg-red" aria-hidden="true"></span>{count} · {f.name}
      </p>
      <h2 id={id} class="mt-6 font-display text-[clamp(1.875rem,1.5rem+1.3vw,2.75rem)] leading-[1.12] tracking-[-0.015em]">
        {f.line[0]} <em>{f.line[1]}</em>
      </h2>
      <p class="mt-6 max-w-[34rem] text-[clamp(1rem,0.96rem+0.25vw,1.125rem)] leading-[1.6] text-ink-2">{f.lead}</p>

      <ul class="mt-10 border-t border-ink">
        {
          f.points.map((p) => (
            <li class="flex gap-4 border-b border-line py-5">
              <span class="grid size-10 shrink-0 place-items-center border border-line-strong bg-white">
                <Glyph name={p.icon} class="size-5" />
              </span>
              <span>
                <span class="block text-[16px] font-medium tracking-[-0.01em]">{p.title}</span>
                <span class="mt-1 block text-[14.5px] leading-[1.55] text-muted">{p.body}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <Button href={`/features/${f.slug}`} variant="light" class="mt-8">more on {f.name.toLowerCase()}</Button>
    </div>

    <div class:list={["lg:col-span-7", flip && "lg:order-1"]}>
      <div class="border-t border-line" aria-hidden="true"></div>
      <div class:list={["border-x border-b border-line p-4 sm:p-8 md:p-10", tintBg[f.tint]]}>
        <Sketch name={f.sketch} />
      </div>
    </div>
  </div>
</section>
