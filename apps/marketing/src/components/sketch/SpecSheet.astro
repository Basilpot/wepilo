---
import NavLink from "../ui/NavLink.astro";
import Glyph from "./Glyph.astro";
import type { GlyphName } from "./util";
import { SETUP_CALL_URL } from "../../config";

/**
 * A feature's parts as a technical spec sheet: a ruler, then numbered cells with an icon, a title,
 * one line, and where the part lives in the dashboard. A hatched cell squares off uneven rows.
 */
interface Props {
  name: string;
  /** Exact heading; defaults to "What's in <name>". */
  title?: string;
  items: Array<{ icon: GlyphName; title: string; note: string; where: string }>;
}
const { name, title, items } = Astro.props;
const n = items.length;
const lgFill = (4 - (n % 4)) % 4;
const smFill = n % 2;
const lgSpan = { 1: "lg:col-span-1", 2: "lg:col-span-2", 3: "lg:col-span-3" }[lgFill] ?? "";
const smSpan = smFill ? "sm:col-span-1" : "sm:col-span-2";
const pad = (i: number) => String(i + 1).padStart(2, "0");
---

<section class="wrap" aria-labelledby="spec-title">
  <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="font-mono text-[14px] lowercase text-muted">[ spec sheet ]</p>
      <h2 id="spec-title" class="mt-4 font-display text-[clamp(1.75rem,1.45rem+1vw,2.375rem)] leading-[1.12] tracking-[-0.015em]">
        {title ?? `What's in ${name.toLowerCase()}`}
      </h2>
    </div>
    <p class="flex gap-6 font-mono text-[13px] lowercase text-muted">
      <span>[ {pad(n - 1)} parts ]</span>
      <span>[ every plan ]</span>
    </p>
  </div>

  <div class="border-t border-line mt-8" aria-hidden="true"></div>

  <ul class="reveal grid gap-px border-x border-b border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
    {
      items.map((it, i) => (
        <li class="spec-cell group relative flex flex-col bg-paper p-6 sm:min-h-[236px] transition-colors duration-200 hover:bg-mist md:p-7">
          <span class="spec-mark left-0 top-0" aria-hidden="true" />
          <span class="spec-mark right-0 top-0" aria-hidden="true" />
          <div class="flex items-start justify-between">
            <span class="font-mono text-[12px] text-faint">{pad(i)}</span>
            <Glyph name={it.icon} class="size-7 text-ink transition-colors duration-200 group-hover:text-red" />
          </div>
          <h3 class="mt-6 text-[17px] sm:mt-12 font-medium leading-[1.3] tracking-[-0.01em]">{it.title}</h3>
          <p class="mt-2 text-[14.5px] leading-[1.55] text-muted">{it.note}</p>
          <p class="mt-auto flex items-center gap-2 pt-6 font-mono text-[11.5px] lowercase text-faint">
            <span class="text-line-strong">→</span>
            {it.where}
          </p>
        </li>
      ))
    }
    {
      (lgFill > 0 || smFill > 0) && (
        <li class:list={["hatch flex min-h-[160px] sm:min-h-[236px] flex-col justify-end bg-paper p-6 md:p-7", smSpan, lgSpan, lgFill === 0 && "lg:hidden", smFill === 0 && lgFill > 0 && "max-lg:hidden"]}>
          <p class="max-w-[24ch] bg-paper text-[15px] leading-[1.5] text-ink-2">See it working on your own trips, on a free setup call.</p>
          <NavLink href={SETUP_CALL_URL} red class="mt-3 self-start bg-paper text-[13.5px]">book a setup call</NavLink>
        </li>
      )
    }
  </ul>
</section>
