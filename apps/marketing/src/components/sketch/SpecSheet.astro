---
import Glyph from "./Glyph.astro";
import type { GlyphName } from "./util";
import { SETUP_CALL_URL } from "../../config";
import Ridge from "../site/Ridge.astro";
import SplitHead from "../site/SplitHead.astro";
import Button from "../ui/Button.astro";

/**
 * A feature's parts on a cobalt band: the hero-style split head, then glass cells with an icon,
 * a title, one line and where the part lives in the dashboard. A white call-to-action card
 * squares off uneven rows.
 */
interface Props {
  name: string;
  /** Exact heading; defaults to "What's in <name>". */
  title?: string;
  items: Array<{ icon: GlyphName; title: string; note: string; where: string }>;
}
const { name, title, items } = Astro.props;
const n = items.length;
const lgFill = (4 - (n % 4)) % 4;
const smFill = n % 2;
const lgSpan = { 1: "lg:col-span-1", 2: "lg:col-span-2", 3: "lg:col-span-3" }[lgFill] ?? "";
const smSpan = smFill ? "sm:col-span-1" : "sm:col-span-2";
const pad = (i: number) => String(i + 1).padStart(2, "0");
---

<section aria-labelledby="spec-title">
  <Ridge seed={n * 11 + name.length} />
  <div class="sky relative isolate px-5 pb-24 pt-14 text-white md:px-10 md:pb-28 md:pt-16 xl:px-[72px]">
    <div class="grain pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <SplitHead id="spec-title" dark lead={`${n} parts, all included in every plan. Here's what each one does and where it lives in your dashboard.`}>
      <Fragment slot="title">{title ?? <>What's in <em>{name.toLowerCase()}.</em></>}</Fragment>
    </SplitHead>

    <ul class="mt-14 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((it, i) => (
          <li class="frost-dark flex flex-col p-6 sm:min-h-[248px] md:p-7">
            <div>
              <span class="grid size-11 place-items-center rounded-[8px] bg-white/12 shadow-[inset_0_0_0_1px_rgb(255_255_255/0.18)]">
                <Glyph name={it.icon} class="size-[22px]" />
              </span>
            </div>
            <h3 class="mt-8 text-[18px] font-medium leading-[1.3] tracking-[-0.015em]">{it.title}</h3>
            <p class="mt-2 text-[15px] leading-[1.55] text-white/70">{it.note}</p>
            <p class="mt-auto flex items-center gap-2 pt-6 text-[13px] lowercase text-white/55">
              <span aria-hidden="true">→</span>
              {it.where}
            </p>
          </li>
        ))
      }
      {
        (lgFill > 0 || smFill > 0) && (
          <li class:list={["flex min-h-[180px] flex-col justify-end rounded-[8px] bg-white p-6 text-ink sm:min-h-[248px] md:p-7", smSpan, lgSpan, lgFill === 0 && "lg:hidden", smFill === 0 && lgFill > 0 && "max-lg:hidden"]}>
            <p class="max-w-[26ch] text-[clamp(1.25rem,1.15rem+0.4vw,1.5rem)] font-light leading-[1.2] tracking-[-0.03em]">See it working on your own trips, on a free setup call.</p>
            <Button href={SETUP_CALL_URL} variant="red" size="sm" class="mt-5 self-start">Book a setup call</Button>
          </li>
        )
      }
    </ul>
  </div>
</section>
