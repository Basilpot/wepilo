---
import SketchFrame from "./SketchFrame.astro";
import type { Callout } from "./util";

/**
 * Enquiries: the form on the agency's site, and the message landing in the email they already use.
 * Wepilo doesn't keep an inbox; it sends each enquiry to the addresses chosen
 * in settings › email (up to ten).
 */
interface Props {
  annotated?: boolean;
}
const { annotated = false } = Astro.props;

const mail = [
  { subject: "New enquiry: Inca Trail to Machu Picchu", from: "Hannah Becker", t: "2m", fresh: true },
  { subject: "Ask about a date: Kilimanjaro, 12 jan 2027", from: "Sofia Martín", t: "1h", fresh: true },
  { subject: "Re: Greek Island Hop, private group", from: "Camille Laurent", t: "3h", fresh: false },
  { subject: "Invoice 2027-014", from: "Accounts", t: "1d", fresh: false },
];

const callouts: Callout[] = [
  { at: [300, 210], to: [262, 210], side: "left", lines: ["your contact and", "trip forms"] },
  { at: [900, 118], to: [940, 108], side: "right", lines: ["arrives in the email", "you already use"] },
  { at: [900, 470], to: [940, 470], side: "right", lines: ["choose who gets them,", "up to ten addresses"] },
];
---

<SketchFrame title="An enquiry form on an agency website, and the message arriving in the agency's own email." callouts={callouts} annotated={annotated}>
  <!-- The form on the agency's site. -->
  <rect x="300" y="90" width="230" height="320" class="w" />
  <text x="316" y="114" class="m">your-agency.travel</text>
  <line x1="300" y1="126" x2="530" y2="126" />
  <text x="316" y="156" class="s" style="font-size:16px">Inca Trail to Machu Picchu</text>
  <text x="316" y="176" class="m">ask about this trip</text>
  {
    [
      ["name", 196, 22],
      ["email", 244, 22],
      ["message", 292, 54],
    ].map(([label, y, h]) => (
      <g>
        <text x="316" y={Number(y)} class="m">{label}</text>
        <rect x="316" y={Number(y) + 6} width="198" height={Number(h)} />
      </g>
    ))
  }
  <rect x="316" y="364" width="198" height="28" class="k" />
  <text x="415" y="382" text-anchor="middle" class="m" style="fill:#fff">send enquiry</text>

  <!-- Hand-off. -->
  <path d="M530 378 C 556 378, 552 160, 574 160" class="dash" />
  <path d="M568 155 L575 160 L568 165" />

  <!-- The agency's own email. -->
  <rect x="580" y="60" width="320" height="270" class="w" />
  <text x="596" y="84" class="m">inbox · hello@your-agency.travel</text>
  <line x1="580" y1="96" x2="900" y2="96" />
  {
    mail.map((m, i) => {
      const y = 96 + i * 52;
      return (
        <g>
          {m.fresh && <rect x="596" y={y + 18} width="7" height="7" class="r" />}
          <text x="612" y={y + 25} style="font-size:12px" class={m.fresh ? "b" : ""}>{m.subject}</text>
          <text x="612" y={y + 42} class="m">{m.from}</text>
          <text x="884" y={y + 42} text-anchor="end" class="m">{m.t}</text>
          {i < mail.length - 1 && <line x1="580" y1={y + 52} x2="900" y2={y + 52} class="g" />}
        </g>
      );
    })
  }

  <!-- Email settings in Wepilo. -->
  <rect x="580" y="370" width="320" height="170" class="w" />
  <text x="596" y="394" class="m">wepilo · settings › email</text>
  <line x1="580" y1="406" x2="900" y2="406" />
  <text x="596" y="430" style="font-size:12px">Send enquiries to</text>
  <rect x="596" y="442" width="190" height="24" />
  <text x="606" y="458" class="m" style="fill:#0d0d0d">hello@your-agency.travel</text>
  <rect x="596" y="474" width="190" height="24" />
  <text x="606" y="490" class="m" style="fill:#0d0d0d">sales@your-agency.travel</text>
  <rect x="796" y="474" width="88" height="24" class="g dash" />
  <text x="840" y="490" text-anchor="middle" class="m">+ add</text>
  <text x="596" y="524" class="m">up to 10 addresses</text>
</SketchFrame>
