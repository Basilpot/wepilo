---
import { sceneStyle } from "../../lib/tints";
import type { SketchName, Tint } from "../../data/features";
import Sketch from "./Sketch.astro";

/** A grid card: the drawing without notes, a name, one line, and a bracketed link. */
interface Props {
  href: string;
  sketch?: SketchName;
  name: string;
  summary: string;
  /** Shown top-right in mono, e.g. "03". */
  index?: string;
  tint?: Tint;
  /** Bigger type, for wide cards in a bento grid. */
  large?: boolean;
  /** Frosted glass in white type, for the cobalt bands. */
  dark?: boolean;
  class?: string;
}
const { href, sketch, name, summary, tint, large = false, dark = false, class: cls } = Astro.props;
---

<a
  href={href}
  class:list={[
    "group relative flex flex-col overflow-hidden rounded-[8px] p-6 transition-colors duration-200 md:p-7",
    dark ? "frost-dark text-white hover:bg-white/15" : "border border-line bg-paper hover:border-ink hover:bg-mist",
    cls,
  ]}
>
  {
    sketch && (
      <div
        class:list={["-mx-6 -mt-6 mb-8 flex items-center border-b border-line px-5 py-6 md:-mx-7 md:-mt-7 md:px-6", !large && "min-h-[236px]", large && "md:px-14", tint && "painted"]}
        style={tint ? sceneStyle(tint) : undefined}
      >
        <div class:list={["frost w-full p-3", large && "mx-auto max-w-[480px]"]}><Sketch name={sketch} /></div>
      </div>
    )
  }
  <h3 class:list={["font-display tracking-[-0.035em]", large ? "text-[clamp(1.5rem,1.3rem+0.8vw,2rem)]" : "text-[21px]", !sketch && "mt-10"]}>{name}</h3>
  <p class:list={["mt-2 flex-1 text-[15.5px] leading-[1.55]", dark ? "text-white/70" : "text-muted"]}>{summary}</p>
  <p class:list={["mt-7 flex items-center justify-between text-[14px]", dark ? "text-white" : "text-ink"]}>
    <span class:list={["transition-colors", !dark && "group-hover:text-red"]}>Read more</span>
    <span class:list={["translate-x-0 transition-transform duration-200 group-hover:translate-x-1", !dark && "group-hover:text-red"]} aria-hidden="true">→</span>
  </p>
</a>
