---
import { sceneStyle } from "../../lib/tints";
import type { SketchName, Tint } from "../../data/features";
import SplitHead from "../site/SplitHead.astro";
import Sketch from "./Sketch.astro";

/**
 * A full-width painted band: the hero-style split head (headline left, lead and buttons right),
 * then the annotated drawing on a frosted pane over the landscape.
 */
interface Props {
  line: [string, string];
  sketch: SketchName;
  /** Kept for callers; the headline is the visible heading. */
  name?: string;
  sub: string;
  /** "h1" on a feature or solution page, "h2" when repeated down the homepage. */
  level?: "h1" | "h2";
  id: string;
  /** Sets the section on this tint's painted landscape. */
  tint?: Tint;
  /** First thing on the page: the scene runs up behind the floating nav. Slot "crumb" sits above the head. */
  top?: boolean;
  class?: string;
}
const { line, sketch, sub, level = "h2", id, tint, top = false, class: cls } = Astro.props;
---

<section class:list={[cls, tint && "painted painted-head pb-10 md:pb-16", tint && (top ? "painted-top pt-36 md:pt-44" : "pt-20 md:pt-28")]} style={tint ? sceneStyle(tint) : undefined} aria-labelledby={id}>
  <div class="px-5 md:px-10 xl:px-[72px]">
    <div class="mb-10 empty:hidden md:mb-14"><slot name="crumb" /></div>
    <SplitHead id={id} level={level} lead={sub}>
      <Fragment slot="title">{`${line[0]} `}<em>{line[1]}</em></Fragment>
      <slot />
    </SplitHead>

    <div class="frost mx-auto mt-12 max-w-[1240px] px-4 py-6 sm:px-8 md:mt-16 md:px-12 md:py-10">
      <Sketch name={sketch} annotated />
    </div>
    <div class="mx-auto mt-3 max-w-[1240px] empty:hidden"><slot name="after" /></div>
  </div>
</section>
