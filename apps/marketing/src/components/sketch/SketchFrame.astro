---
import type { Callout } from "./util";

/**
 * The frame every product sketch is drawn in: thin ink lines on the page grey, with
 * antimattr-style notes (red square markers, dashed leaders, bracketed mono text).
 * Notes are drawn on wide screens and listed underneath on phones.
 */
interface Props {
  title: string;
  callouts?: Callout[];
  /** Show the notes. Without them the sketch is cropped to the drawing. */
  annotated?: boolean;
  /** viewBox used without notes; defaults to the usual drawing area. */
  crop?: string;
  class?: string;
}
const { title, callouts = [], annotated = false, crop, class: cls } = Astro.props;
const CROP = crop ?? "270 30 660 580";
const LINE = 22;
const drawing = await Astro.slots.render("default");
---

<figure class:list={["sketch", cls]}>
  {
    annotated && (
      <svg viewBox={CROP} role="img" aria-label={title} class="sk block h-auto w-full md:hidden">
        <g class="dr"><Fragment set:html={drawing} /></g>
      </svg>
    )
  }
  <svg
    viewBox={annotated ? "0 0 1200 640" : CROP}
    role="img"
    aria-label={title}
    class:list={["sk h-auto w-full", annotated ? "hidden md:block" : "block"]}
  >
    <g class="dr"><Fragment set:html={drawing} /></g>
    {
      annotated && (
        <g class="co" aria-hidden="true">
          {callouts.map((c, ci) => {
            const left = c.side === "left";
            const tx = left ? c.to[0] - 14 : c.to[0] + 14;
            return (
              <g style={`--d:${700 + ci * 180}ms`}>
                <line x1={c.at[0]} y1={c.at[1]} x2={c.to[0]} y2={c.to[1]} />
                <rect x={c.at[0] - 5} y={c.at[1] - 5} width="10" height="10" />
                <rect x={c.to[0] - 5} y={c.to[1] - 5} width="10" height="10" />
                <text x={tx} y={c.to[1] + 5} text-anchor={left ? "end" : "start"}>
                  {c.lines.map((l, i) => (
                    <tspan x={tx} dy={i === 0 ? 0 : LINE}>
                      {i === 0 ? "[" : ""}
                      {l}
                      {i === c.lines.length - 1 ? "]" : ""}
                    </tspan>
                  ))}
                </text>
              </g>
            );
          })}
        </g>
      )
    }
  </svg>
  {
    annotated && callouts.length > 0 && (
      <ol class="mt-6 grid gap-3 font-mono text-[13px] lowercase text-ink-2 md:hidden">
        {callouts.map((c) => (
          <li class="flex gap-3">
            <span class="mt-1.5 size-2 shrink-0 bg-red" aria-hidden="true" />[{c.lines.join(" ")}]
          </li>
        ))}
      </ol>
    )
  }
</figure>
