---
import SketchFrame from "./SketchFrame.astro";
import { ridge, cap, type Callout } from "./util";

/** Website and hosting: homepage sections you switch on and reorder, the site, and the same site on a phone. */
interface Props {
  annotated?: boolean;
}
const { annotated = false } = Astro.props;

const sections: Array<[string, boolean]> = [
  ["Hero banner", true],
  ["Featured trips", true],
  ["Destinations", false],
  ["Reviews", true],
  ["Journal", true],
  ["Newsletter", true],
];

const star = (cx: number, cy: number, r: number) => {
  const pts: string[] = [];
  for (let i = 0; i < 10; i++) {
    const a = -Math.PI / 2 + (i * Math.PI) / 5;
    const rr = i % 2 === 0 ? r : r * 0.45;
    pts.push(`${(cx + rr * Math.cos(a)).toFixed(1)},${(cy + rr * Math.sin(a)).toFixed(1)}`);
  }
  return pts.join(" ");
};

const callouts: Callout[] = [
  { at: [300, 200], to: [262, 200], side: "left", lines: ["switch on and reorder", "homepage sections"] },
  { at: [910, 76], to: [990, 70], side: "right", lines: ["your own domain,", "with ssl"] },
  { at: [960, 470], to: [990, 470], side: "right", lines: ["works on phones"] },
];
---

<SketchFrame title="Homepage sections being arranged, the resulting website, and the same site on a phone." callouts={callouts} annotated={annotated} crop="280 40 700 520">
  <!-- The site. -->
  <rect x="530" y="60" width="380" height="470" class="w" />
  <line x1="530" y1="92" x2="910" y2="92" />
  {[546, 560, 574].map((x) => <circle cx={x} cy="76" r="3.5" />)}
  <rect x="610" y="68" width="210" height="16" />
  <path d="M620 77 h6 v5 h-6 z M621.5 77 v-2.5 a1.5 1.5 0 0 1 3 0 v2.5" />
  <text x="632" y="80" class="m" style="font-size:9.5px">your-agency.travel</text>

  <image href="/video/island.jpg" x="546" y="108" width="348" height="124" preserveAspectRatio="xMidYMid slice" />
  <rect x="546" y="108" width="348" height="124" />
  <text x="560" y="134" class="s" style="font-size:16px;fill:#fff">Journeys worth taking</text>

  <text x="546" y="256" class="m">featured trips</text>
  {
    [0, 1, 2].map((i) => {
      const x = 546 + i * 120;
      return (
        <g>
          <rect x={x} y="266" width="108" height="100" class="w" />
          <image href={`/video/${["ridge", "wing", "viewpoint"][i]}.jpg`} x={x} y="266" width="108" height="56" preserveAspectRatio="xMidYMid slice" />
          <line x1={x} y1="322" x2={x + 108} y2="322" />
          <rect x={x + 8} y="332" width="74" height="5" class="bar" />
          <rect x={x + 8} y="346" width="44" height="5" class="bar" />
        </g>
      );
    })
  }

  <text x="546" y="394" class="m">reviews</text>
  {[0, 1, 2, 3, 4].map((i) => <polygon points={star(552 + i * 16, 412, 6)} class="k" stroke="none" />)}
  <rect x="546" y="428" width="230" height="6" class="bar" />
  <rect x="546" y="442" width="170" height="6" class="bar" />
  <line x1="530" y1="480" x2="910" y2="480" />
  {[546, 600, 650, 700].map((x) => <rect x={x} y="500" width="36" height="5" class="bar" />)}

  <!-- The phone. -->
  <rect x="840" y="300" width="120" height="236" class="w" />
  <rect x="884" y="308" width="32" height="5" class="bar" />
  <image href="/video/island.jpg" x="850" y="324" width="100" height="70" preserveAspectRatio="xMidYMid slice" />
  <rect x="850" y="324" width="100" height="70" />
  <rect x="850" y="404" width="70" height="5" class="bar" />
  <rect x="850" y="416" width="50" height="5" class="bar" />
  <image href="/video/ridge.jpg" x="850" y="432" width="100" height="60" preserveAspectRatio="xMidYMid slice" />
  <rect x="850" y="432" width="100" height="60" />
  <rect x="850" y="504" width="64" height="18" class="k" />

  <!-- Homepage sections. -->
  <rect x="300" y="100" width="210" height="370" class="w" />
  <text x="316" y="124" class="m">homepage sections</text>
  <line x1="300" y1="136" x2="510" y2="136" />
  {
    sections.map(([label, on], i) => {
      const y = 166 + i * 50;
      return (
        <g>
          {[0, 1, 2].map((r) => (
            <g>
              <circle cx="316" cy={y - 8 + r * 7} r="1.5" class="k" stroke="none" />
              <circle cx="322" cy={y - 8 + r * 7} r="1.5" class="k" stroke="none" />
            </g>
          ))}
          <text x="336" y={y + 4} style="font-size:12.5px">{label}</text>
          <rect x="458" y={y - 8} width="34" height="16" class={on ? "k" : "w"} />
          <rect x={on ? 476 : 460} y={y - 6} width="14" height="12" class="w" />
          {i < sections.length - 1 && <line x1="300" y1={y + 25} x2="510" y2={y + 25} class="g" />}
        </g>
      );
    })
  }
</SketchFrame>
