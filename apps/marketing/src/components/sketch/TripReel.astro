---
import Video from "../site/Video.astro";

/**
 * Four looping clips of the kinds of trips agencies sell, each with the trip card Wepilo would publish.
 * Sample trips, not customers. Clips are Mixkit (free licence), self-hosted in /public/video.
 */
const reel = [
  { clip: "ridge", kind: "treks", name: "Tour du Mont Blanc", facts: ["11 days", "3 countries"], price: "$2,390" },
  { clip: "island", kind: "islands", name: "Greek Island Hop", facts: ["9 days", "4 islands"], price: "$1,640" },
  { clip: "viewpoint", kind: "summits", name: "Kilimanjaro, Machame", facts: ["7 days", "5,895 m"], price: "$2,150" },
  { clip: "wing", kind: "multi-country", name: "Grand Tour of Europe", facts: ["16 days", "5 countries"], price: "$3,950" },
];
---

<section class="wrap" aria-labelledby="reel-title">
  <h2 id="reel-title" class="mx-auto max-w-[22ch] text-center font-display text-[clamp(1.875rem,1.5rem+1.3vw,2.75rem)] leading-[1.12] tracking-[-0.015em]">
    Whatever you sell, <em>one way to publish it.</em>
  </h2>
  <p class="mx-auto mt-6 max-w-[34rem] text-center text-[clamp(1rem,0.96rem+0.25vw,1.125rem)] leading-[1.6] text-ink-2">
    Treks, island hops, summits and multi-country tours all use the same trip page, so your team learns it once.
  </p>

  <div class="border-t border-line mt-14" aria-hidden="true"></div>
  <ul class="reveal grid gap-px border-x border-b border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
    {
      reel.map((r, i) => (
        <li class="group relative flex aspect-[3/4] flex-col justify-between overflow-hidden bg-ink p-4 text-white">
          <div class="absolute inset-0 -z-0 transition-transform duration-700 group-hover:scale-[1.03]">
            <Video name={r.clip} />
          </div>
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/35 via-transparent to-black/10" aria-hidden="true" />
          <p class="relative flex items-center justify-between font-mono text-[12.5px] lowercase text-white/85">
            <span>[ {r.kind} ]</span>
            <span>0{i + 1}</span>
          </p>
          <div class="relative border border-line bg-paper p-4 text-ink">
            <p class="flex items-center gap-2 font-mono text-[11px] lowercase text-muted">
              <span class="size-1.5 bg-red" aria-hidden="true" />live on site
            </p>
            <p class="mt-2 font-display text-[19px] leading-[1.15]">{r.name}</p>
            <p class="mt-2 flex items-baseline justify-between font-mono text-[11.5px] text-muted">
              <span>{r.facts.join(" · ")}</span>
              <span class="text-ink">from {r.price}</span>
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
