---
import SketchFrame from "./SketchFrame.astro";
import { ridge, type Callout } from "./util";

/** The trip editor: the steps of a trip page on the left, a day-by-day itinerary being reordered. */
interface Props {
  annotated?: boolean;
}
const { annotated = false } = Astro.props;

const steps = ["the trip", "itinerary", "photos and map", "what's included", "practical details", "price and extras", "before booking", "seo"];
const days = [
  ["day 1", "Machame Gate to Machame Camp", "2,835 m"],
  ["day 2", "Machame Camp to Shira Cave", "3,750 m"],
  ["day 3", "Shira Cave to Barranco Camp", "3,976 m"],
  ["day 4", "Barranco Camp to Karanga Camp", "3,995 m"],
];

const callouts: Callout[] = [
  { at: [300, 150], to: [262, 150], side: "left", lines: ["the sections a trip", "page needs, ticked off"] },
  { at: [888, 244], to: [940, 230], side: "right", lines: ["day-by-day itinerary,", "drag to reorder"] },
  { at: [866, 478], to: [940, 470], side: "right", lines: ["photos resized for", "the web on upload"] },
];
---

<SketchFrame title="The Wepilo trip editor with an itinerary being reordered." callouts={callouts} annotated={annotated}>
  <rect x="300" y="50" width="600" height="530" class="w" />
  <line x1="300" y1="86" x2="900" y2="86" />
  <text x="318" y="73" class="m">trips / kilimanjaro, machame route</text>
  <rect x="826" y="60" width="58" height="18" />
  <text x="855" y="73" text-anchor="middle" class="m">draft</text>

  <line x1="460" y1="86" x2="460" y2="580" />
  {
    steps.map((s, i) => {
      const y = 118 + i * 32;
      const done = i < 5;
      return (
        <g>
          {i === 1 && <rect x="304" y={y - 13} width="152" height="26" class="f2" />}
          <circle cx="320" cy={y} r="6" class={done ? "k" : "w"} />
          {done && <path d={`M317 ${y} l2.2 2.4 4-4.6`} style="stroke:#fff;stroke-width:1.4" />}
          <text x="334" y={y + 4} style="font-size:11.5px">{s}</text>
        </g>
      );
    })
  }

  <text x="484" y="122" class="s" style="font-size:22px">Itinerary</text>
  <text x="484" y="142" class="m">7 days · drag a day to move it</text>
  {
    days.map(([d, t, alt], i) => {
      const lift = i === 1;
      const x = lift ? 492 : 484;
      const y = 160 + i * 66 - (lift ? 6 : 0);
      return (
        <g>
          {lift && <rect x="484" y={160 + i * 66} width="396" height="54" class="g dash" />}
          <rect x={x} y={y} width="396" height="54" class="w" />
          {[0, 1, 2].map((r) => (
            <g>
              <circle cx={x + 12} cy={y + 18 + r * 8} r="1.6" class="k" stroke="none" />
              <circle cx={x + 18} cy={y + 18 + r * 8} r="1.6" class="k" stroke="none" />
            </g>
          ))}
          <text x={x + 32} y={y + 21} class="m">{d}</text>
          <text x={x + 32} y={y + 40} style="font-size:13px">{t}</text>
          <text x={x + 384} y={y + 21} text-anchor="end" class="m">{alt}</text>
        </g>
      );
    })
  }

  <text x="484" y="436" class="m">photos</text>
  {
    [0, 1, 2, 3].map((i) => {
      const x = 484 + i * 98;
      return (
        <g>
          <image href={`/video/${["summit-walk", "ridge", "viewpoint", "island"][i]}.jpg`} x={x} y="446" width="88" height="64" preserveAspectRatio="xMidYMid slice" />
          <rect x={x} y="446" width="88" height="64" />
          {i === 0 && (
            <g>
              <rect x={x + 4} y="450" width="40" height="14" class="k" />
              <text x={x + 24} y="460" text-anchor="middle" class="m" style="font-size:8.5px;fill:#fff">cover</text>
            </g>
          )}
        </g>
      );
    })
  }

  <rect x="652" y="534" width="110" height="28" />
  <text x="707" y="552" text-anchor="middle" class="m">preview</text>
  <rect x="770" y="534" width="110" height="28" class="k" />
  <text x="825" y="552" text-anchor="middle" class="m" style="fill:#fff">save draft</text>
</SketchFrame>
