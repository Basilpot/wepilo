---
interface Props {
  dashboard: string;
}

const { dashboard } = Astro.props;

const columns = [
  {
    title: "Product",
    links: [
      { label: "Trips & departures", href: "/#desk" },
      { label: "Bookings & enquiries", href: "/#desk" },
      { label: "Wepilo for AI", href: "/#assistant" },
      { label: "Pricing", href: "/pricing" },
    ],
  },
  {
    title: "Developers",
    links: [
      { label: "API guide", href: "/developers#api" },
      { label: "AI connector", href: "/developers#connector" },
      { label: "Authentication", href: "/developers#auth" },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "Who it's for", href: "/#built-for" },
      { label: "For developers", href: "/#developers" },
      { label: "Talk to us", href: "/#talk" },
    ],
  },
  {
    title: "Connect",
    links: [
      { label: "Sign in", href: `${dashboard}/login` },
      { label: "Create a workspace", href: `${dashboard}/signup` },
      { label: "Email us", href: "mailto:hello@wepilo.com" },
      { label: "API reference", href: "/developers" },
    ],
  },
];
---

<footer class="rule">
  <div class="shell">
    <div class="grid gap-10 py-16 md:grid-cols-[1.2fr_repeat(4,1fr)] md:py-20">
      <div>
        <a href="/" class="flex items-center gap-2" aria-label="Wepilo home">
          <span class="flex size-8 items-center justify-center rounded-[7px] bg-ink text-white">
            <svg viewBox="0 0 24 24" class="size-4" fill="none" aria-hidden="true">
              <path d="M2 19h20L14.7 5.9a1 1 0 0 0-1.74 0L8.4 12.3 6.9 9.9a1 1 0 0 0-1.68.06L2 19Z" fill="currentColor"></path>
            </svg>
          </span>
          <span class="text-xl font-medium tracking-[-0.02em]">Wepilo</span>
        </a>
        <p class="mt-4 max-w-[15rem] text-sm leading-6 text-muted">
          The back office for travel agencies. Trips, bookings, enquiries and your website, in one place.
        </p>
      </div>

      {
        columns.map((column) => (
          <div>
            <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-faint">{column.title}</p>
            <ul class="mt-4 space-y-2.5">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-muted transition-colors hover:text-ink">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="flex flex-col gap-4 border-t border-line py-8 text-[13px] text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} Wepilo. Made for agencies that answer their own email.</p>
      <p class="flex items-center gap-4">
        <span>Illustrations after the Annapurna range</span>
      </p>
    </div>
  </div>
</footer>
