---
import Site from "../../layouts/Site.astro";
import SketchCard from "../../components/sketch/SketchCard.astro";
import { features } from "../../data/features";

const pad = (i: number) => String(i + 1).padStart(2, "0");
/** Bento: wide, narrow, narrow / narrow, narrow, wide / wide, wide. Columns on a 4-wide grid. */
const span = [2, 1, 1, 1, 1, 2, 2, 2];
---

<Site
  title="Features · Wepilo"
  description="Trip pages, departures, a content calendar, an AI assistant, languages, roles, SEO, enquiries by email and hosting: everything a travel agency website needs."
>
  <section class="wrap pt-16 text-center md:pt-24" aria-labelledby="features-title">
    <p class="font-mono text-[14px] font-medium lowercase text-muted">[ features ]</p>
    <h1 id="features-title" class="mx-auto mt-6 max-w-[22ch] font-display text-[clamp(2rem,1.55rem+1.5vw,2.875rem)] leading-[1.12] tracking-[-0.015em]">
      Everything a travel site needs, <em>in one place to edit.</em>
    </h1>
    <p class="mx-auto mt-6 max-w-[34rem] text-[clamp(1rem,0.96rem+0.25vw,1.125rem)] leading-[1.6] text-ink-2">
      Eight parts, one dashboard, included in every plan. Pick one to see how it works.
    </p>
  </section>

  <section class="wrap pt-16 md:pt-20" aria-label="All features">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        features.map((f, i) => (
          <SketchCard
            href={`/features/${f.slug}`}
            sketch={f.sketch}
            tint={f.tint}
            name={f.name}
            summary={f.summary}
            index={pad(i)}
            large={span[i] === 2}
            class={span[i] === 2 ? "sm:col-span-2" : ""}
          />
        ))
      }
    </div>
  </section>
</Site>
