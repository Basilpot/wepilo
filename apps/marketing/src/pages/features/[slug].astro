---
import NavLink from "../../components/ui/NavLink.astro";
import Button from "../../components/ui/Button.astro";
import Site from "../../layouts/Site.astro";
import SketchBlock from "../../components/sketch/SketchBlock.astro";
import SketchCard from "../../components/sketch/SketchCard.astro";
import SpecSheet from "../../components/sketch/SpecSheet.astro";
import PointsRow from "../../components/sketch/PointsRow.astro";
import { features, type Feature } from "../../data/features";
import { solutions } from "../../data/solutions";
import { SETUP_CALL_URL } from "../../config";

export function getStaticPaths() {
  return features.map((f) => ({ params: { slug: f.slug }, props: { f } }));
}

const { f } = Astro.props as { f: Feature };
const others = features.filter((o) => o.slug !== f.slug).slice(0, 3);
const usedBy = solutions.filter((s) => s.helps.some((h) => h.feature === f.slug));
---

<Site title={`${f.name} · Wepilo`} description={f.lead}>
  <nav aria-label="Breadcrumb" class="wrap pt-10 text-center font-mono text-[13px] lowercase text-muted">
    <a href="/features" class="hover:text-red">features</a> <span class="text-line-strong">/</span> {f.name.toLowerCase()}
  </nav>

  <SketchBlock id="feature-title" level="h1" class="mt-8 md:mt-10" tint={f.tint} line={f.line} sketch={f.sketch} name={f.name} sub={f.lead} tag="included in every plan">
    <Button href="/pricing" variant="light">see pricing</Button>
    <Button href={SETUP_CALL_URL} variant="dark">book a setup call</Button>
  </SketchBlock>

  <!-- How it helps. -->
  <div class="pt-36 md:pt-48">
    <PointsRow items={f.points} label={`What ${f.name.toLowerCase()} does`} />
  </div>

  <div class="pt-36 md:pt-48">
    <SpecSheet name={f.name} items={f.details} />
  </div>

  {
    usedBy.length > 0 && (
      <section class="wrap pt-36 md:pt-48" aria-labelledby="used-title">
        <div class="flex flex-col gap-4 border-y border-line py-6 md:flex-row md:items-center md:gap-10">
          <h2 id="used-title" class="shrink-0 font-mono text-[13px] lowercase text-muted">[ who relies on it ]</h2>
          <ul class="flex flex-wrap gap-x-8 gap-y-3">
            {usedBy.map((s) => (
              <li>
                <NavLink href={`/solutions/${s.slug}`} red class="text-[14px]">{s.name.toLowerCase()}</NavLink>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="wrap pt-20 md:pt-24" aria-labelledby="more-title">
    <h2 id="more-title" class="font-mono text-[14px] lowercase text-muted">[ more features ]</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {others.map((o) => <SketchCard href={`/features/${o.slug}`} sketch={o.sketch} tint={o.tint} name={o.name} summary={o.summary} index={String(features.indexOf(o) + 1).padStart(2, "0")} />)}
    </div>
  </section>
</Site>
