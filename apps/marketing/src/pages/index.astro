---
import NavLink from "../components/ui/NavLink.astro";
import Button from "../components/ui/Button.astro";
import Site from "../layouts/Site.astro";
import Hero from "../components/site/Hero.astro";
import Problem from "../components/site/Problem.astro";
import Faq from "../components/site/Faq.astro";
import SketchBlock from "../components/sketch/SketchBlock.astro";
import SketchCard from "../components/sketch/SketchCard.astro";
import SketchSplit from "../components/sketch/SketchSplit.astro";
import TripReel from "../components/sketch/TripReel.astro";
import Video from "../components/site/Video.astro";
import { features, featureBySlug } from "../data/features";
import { solutions } from "../data/solutions";

/** The homepage repeats the hero's pattern for the four things agencies ask about most. */
const showcase = ["trip-pages", "calendar", "ai-assistant", "languages"].map((s) => featureBySlug(s)!);
const rest = features.filter((f) => !showcase.includes(f));
---

<Site
  title="Wepilo: website software for travel agencies"
  description="Wepilo lets travel and tour agencies update trips, dates and translations themselves. Drafts are written for you, and your team publishes them or schedules them for later."
>
  <Hero />

  <div class="pt-40 md:pt-56">
    <Problem />
  </div>

  <div class="pt-40 md:pt-56">
    <TripReel />
  </div>

  {
    showcase.map((f, i) =>
      i % 2 === 0 ? (
        <SketchBlock id={`home-${f.slug}`} class="mt-32 md:mt-48" tint={f.tint} line={f.line} sketch={f.sketch} name={f.name} sub={f.lead}>
          <Button href={`/features/${f.slug}`} variant="light">
            more on {f.name.toLowerCase()}
          </Button>
        </SketchBlock>
      ) : (
        <SketchSplit id={`home-${f.slug}`} class="pt-32 md:pt-48" feature={f} count={`0${i + 1} / 0${showcase.length}`} flip={i === 3} />
      ),
    )
  }

  <section class="wrap pt-40 md:pt-56" aria-labelledby="rest-title">
    <h2 id="rest-title" class="mx-auto max-w-[22ch] text-center font-display text-[clamp(1.875rem,1.5rem+1.3vw,2.75rem)] leading-[1.12] tracking-[-0.015em]">
      And the parts <em>you'd expect.</em>
    </h2>
    <div class="reveal mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {rest.map((f) => <SketchCard href={`/features/${f.slug}`} sketch={f.sketch} tint={f.tint} name={f.name} summary={f.summary} />)}
    </div>
    <p class="mt-10 text-center">
      <NavLink href="/features">all features</NavLink>
    </p>
  </section>

  <section class="wrap pt-40 md:pt-56" aria-labelledby="for-title">
    <h2 id="for-title" class="mx-auto max-w-[22ch] text-center font-display text-[clamp(1.875rem,1.5rem+1.3vw,2.75rem)] leading-[1.12] tracking-[-0.015em]">
      Built for agencies <em>like yours.</em>
    </h2>
    <div class="reveal mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {solutions.map((s) => <SketchCard href={`/solutions/${s.slug}`} name={s.name} summary={s.summary} />)}
      <SketchCard href="/developers" name="Web developers" summary="Build a client's site once and let the agency run it." />
    </div>
  </section>

  <!-- A quiet media moment before the questions. -->
  <section class="wrap pt-40 md:pt-56" aria-label="A season of trips">
    <div class="border-t border-line" aria-hidden="true"></div>
    <div class="clip clip-scrim relative flex aspect-[4/5] items-end border-x border-b border-line p-6 sm:aspect-[21/9] md:p-12" style="border-radius:0">
      <Video name="cloud-sea" />
      <p class="relative max-w-[18ch] font-display text-[clamp(1.75rem,1.4rem+1.4vw,2.75rem)] leading-[1.12] tracking-[-0.015em] text-white">
        Next season, <em class="!text-white/70">published on time.</em>
      </p>
    </div>
  </section>

  <Faq />
</Site>
