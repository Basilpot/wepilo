---
import Button from "../components/ui/Button.astro";
import Site from "../layouts/Site.astro";
import PageHero from "../components/site/PageHero.astro";
import Faq from "../components/site/Faq.astro";
import { CONTACT_EMAIL, SETUP_CALL_URL, SIGNUP_URL } from "../config";

/** Prices match the Dodo products. One place to change them. */
const AGENCY_PRICE = "$50";
const YEARLY_PRICE = "$499";
const TRIAL = "7-day trial for $2.99";

const plans = [
  {
    id: "agency",
    name: "Active agency",
    price: AGENCY_PRICE,
    per: "/mo",
    for: `Or ${YEARLY_PRICE} a year. For agencies that update trips and posts each month.`,
    items: [
      "Trips, destinations, pages, posts, team, reviews",
      "Owner, admin, manager, editor and author roles",
      "Calendar and scheduled publishing",
      "AI assistant for drafts, translations and publishing",
      "Every language, each on its own address",
      "Hosting, your domain and SSL",
      "Free setup call",
    ],
    note: `Starts with a ${TRIAL}. The AI assistant runs on your own Claude account; the free plan works.`,
    cta: { label: "Start now", href: SIGNUP_URL },
    featured: true,
  },
  {
    id: "build",
    name: "Website build",
    price: "Quote",
    per: "once + yearly hosting",
    for: "We build the site once. For agencies that rarely change it.",
    items: ["Designed and built around your brand", "Your trips and pages moved in", "Hosting, your domain and SSL", "Free setup call"],
    note: "Switch to Active agency whenever you start updating it yourself.",
    cta: { label: "Ask for a quote", href: `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent("Wepilo website build")}` },
    featured: false,
  },
  {
    id: "oss",
    name: "Open source",
    price: "Free",
    per: "self-hosted",
    for: "For developers who run it themselves. We're publishing the code soon.",
    items: ["Core CMS and travel schema", "AGPL-3.0 licence", "Your own infrastructure"],
    note: "No setup call or support included.",
    cta: { label: "For developers", href: "/developers" },
    featured: false,
  },
];

const sum = [
  { k: "Content agency", v: "~$250", note: "plus a wait for every draft" },
  { k: "Wepilo", v: AGENCY_PRICE, note: "changes go live the same day" },
  { k: "Your Claude", v: "$0–20", note: "the free plan works" },
];

const faqs = [
  { q: "Is it per seat?", a: "No. One flat price covers everyone at the agency: writers, editors, the owner." },
  { q: "Is there a trial?", a: `Yes. ${TRIAL}, with everything switched on. After that it's ${AGENCY_PRICE} a month, or ${YEARLY_PRICE} a year.` },
  { q: "Do I pay per word or per translation?", a: "No. Translate and refresh as much as you like. The AI assistant runs on your own Claude account." },
  { q: "Do I need to pay for Claude?", a: "No. The free plan works. Claude Pro (~$20/mo, on your own account) gives more room if you translate a lot." },
  { q: "What if we rarely update the site?", a: "Take the Website build: we build it once and host it. Move to Active agency whenever you start updating." },
];
---

<Site
  title="Pricing · Wepilo"
  description="One flat price for agencies that keep their site current, a one-time build for those that don't, and a free open source core for developers."
>
  <PageHero
    id="pricing-title"
    label="pricing"
    lead="$50 a month or $499 a year covers your whole team. Try it for 7 days for $2.99. There are no per-seat or per-word charges."
  >
    Less than a <em>content agency.</em>
    <Fragment slot="actions">
      <Button href={SETUP_CALL_URL} variant="light">book a setup call</Button>
      <Button href={SIGNUP_URL} variant="dark">start now</Button>
    </Fragment>
  </PageHero>

  <!-- Plans: three cells on one hairline grid; the one most agencies need is inked. -->
  <section class="wrap pt-20 md:pt-28" aria-label="Plans">
    <div class="border-t border-line" aria-hidden="true"></div>
    <div class="grid gap-px border-x border-b border-line bg-line lg:grid-cols-3">
      {
        plans.map((p) => (
          <article
            id={p.id}
            class:list={["spec-cell group relative flex scroll-mt-28 flex-col p-8 md:p-10", p.featured ? "bg-ink text-white" : "bg-paper"]}
          >
            <span class="spec-mark left-0 top-0" aria-hidden="true" />
            <span class="spec-mark right-0 top-0" aria-hidden="true" />
            <div class="flex items-center justify-between gap-4">
              <h2 class:list={["font-mono text-[13px] lowercase", p.featured ? "text-white/70" : "text-muted"]}>[ {p.name} ]</h2>
              {p.featured && <span class="bg-red px-2.5 py-1 font-mono text-[11px] lowercase text-white">recommended</span>}
            </div>
            <p class="mt-12 flex items-baseline gap-2">
              <span class="font-display text-[clamp(3rem,2.6rem+1.4vw,4rem)] leading-none tracking-[-0.03em]">{p.price}</span>
              <span class:list={["font-mono text-[13px]", p.featured ? "text-white/60" : "text-muted"]}>{p.per}</span>
            </p>
            <p class:list={["mt-5 max-w-[30ch] text-[16px] leading-[1.55]", p.featured ? "text-white/80" : "text-ink-2"]}>{p.for}</p>
            <ul class:list={["mt-8 flex-1 border-t pt-2 text-[15px]", p.featured ? "border-white/15" : "border-line"]}>
              {p.items.map((i) => (
                <li class:list={["flex items-baseline gap-3 border-b py-3", p.featured ? "border-white/10" : "border-line"]}>
                  <span class="size-1.5 shrink-0 translate-y-[-2px] bg-red" aria-hidden="true" />
                  {i}
                </li>
              ))}
            </ul>
            <p class:list={["mt-6 text-[13.5px] leading-[1.55]", p.featured ? "text-white/55" : "text-faint"]}>{p.note}</p>
            <Button href={p.cta.href} variant={p.featured ? "light" : "dark"} class="mt-6 w-full">
              {p.cta.label.toLowerCase()}
            </Button>
          </article>
        ))
      }
    </div>
  </section>

  <!-- The sum. -->
  <section class="wrap pt-36 text-center md:pt-48" aria-labelledby="math-title">
    <h2 id="math-title" class="mx-auto max-w-[22ch] font-display text-[clamp(1.875rem,1.5rem+1.3vw,2.75rem)] leading-[1.12] tracking-[-0.015em]">
      About a fifth of <em>what an agency charges.</em>
    </h2>
    <p class="mx-auto mt-6 max-w-[34rem] text-[clamp(1rem,0.96rem+0.25vw,1.125rem)] leading-[1.6] text-ink-2">
      Your team reviews every page either way. With Wepilo the change goes live the same day instead of next week.
    </p>
    <dl class="reveal mx-auto mt-16 grid max-w-[1000px] border-t border-ink text-left md:grid-cols-3">
      {
        sum.map((s, i) => (
          <div class:list={["border-b border-line py-8 md:border-b-0 md:py-10", i > 0 && "md:border-l md:pl-10", i < 2 && "md:pr-10"]}>
            <dt class="font-mono text-[12.5px] lowercase text-muted">{s.k}</dt>
            <dd class:list={["mt-5 flex items-baseline gap-2 font-display text-[clamp(2.5rem,2.1rem+1.2vw,3.25rem)] leading-none tracking-[-0.02em]", i === 1 && "text-red"]}>
              {s.v}
              <span class="font-mono text-[13px] tracking-normal text-muted">/mo</span>
            </dd>
            <dd class="mt-5 text-[15.5px] leading-[1.55] text-ink-2">{s.note}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <Faq id="billing" items={faqs} line={["Billing,", "in plain words."]} />
</Site>
