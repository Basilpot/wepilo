---
import Site from "../../layouts/Site.astro";
import SketchCard from "../../components/sketch/SketchCard.astro";
import PageHero from "../../components/site/PageHero.astro";
import { solutions } from "../../data/solutions";
---

<Site
  overlayNav="light"
  title="Solutions · Wepilo"
  description="Wepilo for tour operators, trekking and adventure agencies, inbound agencies and DMCs, and the developers who build their sites."
>
  <PageHero id="solutions-title" label="solutions" tint="sage" lead="Whatever you sell, the website falls behind when every change needs someone else. Pick the one closest to your agency.">
    Different trips, <em>the same problem.</em>
    <div slot="after" aria-label="All solutions">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {solutions.map((s, i) => <SketchCard href={`/solutions/${s.slug}`} sketch={s.sketch} tint={s.tint} name={s.name} summary={s.summary} />)}
      <SketchCard href="/developers" sketch="api" tint="butter" name="Web developers" summary="Build a client's site once and let the agency run it." />
    </div>
    </div>
  </PageHero>
</Site>
