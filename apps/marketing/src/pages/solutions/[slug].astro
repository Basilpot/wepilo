---
import NavLink from "../../components/ui/NavLink.astro";
import { tintBg } from "../../lib/tints";
import Button from "../../components/ui/Button.astro";
import Site from "../../layouts/Site.astro";
import SketchBlock from "../../components/sketch/SketchBlock.astro";
import SketchCard from "../../components/sketch/SketchCard.astro";
import Sketch from "../../components/sketch/Sketch.astro";
import { solutions, type Solution } from "../../data/solutions";
import { featureBySlug } from "../../data/features";
import { SETUP_CALL_URL } from "../../config";

export function getStaticPaths() {
  return solutions.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Solution };
const helps = s.helps.map((h) => ({ ...h, f: featureBySlug(h.feature)! }));
const pains = s.pains.map((p) => ({ ...p, f: featureBySlug(p.fix)! }));
const others = solutions.filter((o) => o.slug !== s.slug);
---

<Site title={`${s.name} · Wepilo`} description={s.lead}>
  <nav aria-label="Breadcrumb" class="wrap pt-10 text-center font-mono text-[13px] lowercase text-muted">
    <a href="/solutions" class="hover:text-red">solutions</a> <span class="text-line-strong">/</span> {s.name.toLowerCase()}
  </nav>

  <SketchBlock id="solution-title" level="h1" class="mt-8 md:mt-10" tint={s.tint} line={s.line} sketch={s.sketch} name={`Wepilo for ${s.name.toLowerCase()}`} sub={s.lead} tag="free setup call with every plan">
    <Button href="/pricing" variant="light">see pricing</Button>
    <Button href={SETUP_CALL_URL} variant="dark">book a setup call</Button>
  </SketchBlock>

  <!-- Sound familiar? -->
  <section class="wrap pt-36 md:pt-48" aria-labelledby="pains-title">
    <h2 id="pains-title" class="mx-auto max-w-[22ch] text-center font-display text-[clamp(1.75rem,1.45rem+1vw,2.375rem)] leading-[1.12] tracking-[-0.015em]">
      Sound <em>familiar?</em>
    </h2>
    <ul class="reveal mx-auto mt-12 grid max-w-[1100px] border-t border-ink md:grid-cols-3">
      {
        pains.map((p, i) => (
          <li class:list={["flex flex-col border-b border-line py-8 md:border-b-0 md:py-10", i > 0 && "md:border-l md:pl-10", i < 2 && "md:pr-10"]}>
            <p class="flex items-center gap-3 font-mono text-[12px] text-faint">
              <span class="size-2 bg-red" aria-hidden="true" />0{i + 1}
            </p>
            <p class="mt-6 flex-1 text-[17px] leading-[1.55] text-ink">{p.text}</p>
            {(
              <a href={`/features/${p.f.slug}`} class="group mt-8 flex items-center gap-2 border-t border-dashed border-line-strong pt-4 font-mono text-[12.5px] lowercase text-muted hover:text-red">
                <span>fixed by</span>
                <span class="text-ink group-hover:text-red">{p.f.name.toLowerCase()}</span>
                <span class="ml-auto transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- How Wepilo helps: one row per feature, drawing beside the words. -->
  <section class="wrap pt-36 md:pt-48" aria-labelledby="helps-title">
    <h2 id="helps-title" class="mx-auto max-w-[22ch] text-center font-display text-[clamp(1.75rem,1.45rem+1vw,2.375rem)] leading-[1.12] tracking-[-0.015em]">
      How Wepilo <em>helps.</em>
    </h2>
    <div class="mt-16 space-y-24 md:space-y-32">
      {
        helps.map((h, i) => (
          <div class="reveal grid items-center gap-10 md:grid-cols-12 md:gap-14">
            <div class:list={["md:col-span-7", i % 2 === 1 && "md:order-2"]}>
              <div class="border-t border-line" aria-hidden="true"></div>
              <div class:list={["border-x border-b border-line p-4 sm:p-8", tintBg[h.f.tint]]}>
                <Sketch name={h.f.sketch} />
              </div>
            </div>
            <div class:list={["md:col-span-5", i % 2 === 1 && "md:order-1"]}>
              <p class="font-mono text-[13px] text-muted">0{i + 1}</p>
              <h3 class="mt-5 font-display text-[clamp(1.5rem,1.35rem+0.6vw,1.875rem)] leading-[1.15] tracking-[-0.01em]">{h.title}</h3>
              <p class="mt-3 max-w-[36ch] text-[16.5px] leading-[1.6] text-ink-2">{h.body}</p>
              <NavLink href={`/features/${h.f.slug}`} red class="mt-6 text-[14px]">
                {h.f.name.toLowerCase()}
              </NavLink>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap pt-36 md:pt-48" aria-labelledby="other-title">
    <h2 id="other-title" class="font-mono text-[14px] lowercase text-muted">[ also built for ]</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {others.map((o) => <SketchCard href={`/solutions/${o.slug}`} name={o.name} summary={o.summary} />)}
      <SketchCard href="/developers" name="Web developers" summary="Build a client's site once and let the agency run it." />
    </div>
  </section>
</Site>
