---
import NavLink from "../../components/ui/NavLink.astro";
import { sceneStyle } from "../../lib/tints";
import SplitHead from "../../components/site/SplitHead.astro";
import Ridge from "../../components/site/Ridge.astro";
import Button from "../../components/ui/Button.astro";
import Site from "../../layouts/Site.astro";
import SketchBlock from "../../components/sketch/SketchBlock.astro";
import SketchCard from "../../components/sketch/SketchCard.astro";
import Sketch from "../../components/sketch/Sketch.astro";
import { solutions, type Solution } from "../../data/solutions";
import { featureBySlug } from "../../data/features";
import { SETUP_CALL_URL } from "../../config";

export function getStaticPaths() {
  return solutions.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Solution };
const helps = s.helps.map((h) => ({ ...h, f: featureBySlug(h.feature)! }));
const pains = s.pains.map((p) => ({ ...p, f: featureBySlug(p.fix)! }));
const others = solutions.filter((o) => o.slug !== s.slug);
---

<Site overlayNav="light" title={`${s.name} · Wepilo`} description={s.lead}>
  <SketchBlock id="solution-title" level="h1" top tint={s.tint} line={s.line} sketch={s.sketch} name={`Wepilo for ${s.name.toLowerCase()}`} sub={s.lead}>
    <nav slot="crumb" aria-label="Breadcrumb" class="text-[14px] text-ink-2/75">
      <a href="/solutions" class="hover:text-red">Solutions</a> <span class="mx-1 opacity-50">/</span> {s.name}
    </nav>
    <Button href="/pricing" variant="light">see pricing</Button>
    <Button href={SETUP_CALL_URL} variant="dark">book a setup call</Button>

    <!-- Sound familiar? On the scene's foreground, under the drawing. -->
    <section slot="after" aria-labelledby="pains-title">
      <h2 id="pains-title" class="sr-only">Sound familiar?</h2>
      <ul class="grid gap-3 md:grid-cols-3">
        {
          pains.map((p, i) => (
            <li class="frost flex flex-col p-7 md:p-8">
              <p class="flex-1 text-[clamp(1.125rem,1.05rem+0.3vw,1.3rem)] font-light leading-[1.4] tracking-[-0.015em] text-ink">{p.text}</p>
              <a href={`/product/${p.f.slug}`} class="group mt-8 flex items-center gap-2 border-t border-ink/10 pt-4 text-[14px] text-ink-2 hover:text-red">
                <span class="text-ink-2/60">Fixed by</span>
                <span class="font-medium text-ink group-hover:text-red">{p.f.name}</span>
                <span class="ml-auto transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </SketchBlock>

  <!-- How Wepilo helps: one row per feature, the drawing on its painted scene beside the words. -->
  <section class="px-5 pt-24 md:px-10 md:pt-32 xl:px-[72px]" aria-labelledby="helps-title">
    <SplitHead id="helps-title" lead={`The parts of Wepilo ${s.name.toLowerCase()} use most, and what each one takes off your plate.`}>
      <Fragment slot="title">How Wepilo <em>helps.</em></Fragment>
    </SplitHead>
    <div class="mt-16 space-y-6 md:space-y-8">
      {
        helps.map((h, i) => (
          <div class="grid items-stretch gap-6 rounded-[8px] bg-mist p-3 md:grid-cols-12 md:gap-10 md:p-4">
            <div class:list={["painted flex items-center overflow-hidden rounded-[6px] px-4 py-8 sm:px-8 md:col-span-7 md:py-12", i % 2 === 1 && "md:order-2"]} style={sceneStyle(h.f.tint)}>
              <div class="frost w-full p-4 sm:p-5">
                <Sketch name={h.f.sketch} />
              </div>
            </div>
            <div class:list={["flex flex-col justify-center px-3 pb-5 md:col-span-5 md:px-4 md:pb-0", i % 2 === 1 && "md:order-1"]}>
              <h3 class="text-[clamp(1.625rem,1.4rem+0.9vw,2.25rem)] font-light leading-[1.12] tracking-[-0.04em]">{h.title}</h3>
              <p class="mt-4 max-w-[38ch] text-[16.5px] leading-[1.6] text-ink-2">{h.body}</p>
              <NavLink href={`/product/${h.f.slug}`} red class="mt-6 self-start text-[15px]">
                More on {h.f.name.toLowerCase()}
              </NavLink>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="pt-24 md:pt-32" aria-labelledby="other-title">
    <Ridge seed={s.name.length * 7} />
    <div class="sky relative isolate px-5 pb-24 pt-14 text-white md:px-10 md:pb-28 md:pt-16 xl:px-[72px]">
      <div class="grain pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
      <SplitHead id="other-title" dark lead="Same editor, same calendar, set up around how each kind of agency sells.">
        <Fragment slot="title">Also built <em>for.</em></Fragment>
      </SplitHead>
      <div class="mt-14 grid gap-3 md:grid-cols-3">
        {others.map((o) => <SketchCard dark href={`/solutions/${o.slug}`} name={o.name} summary={o.summary} />)}
        <SketchCard dark href="/developers" name="Web developers" summary="Build a client's site once and let the agency run it." />
      </div>
    </div>
  </section>
</Site>
