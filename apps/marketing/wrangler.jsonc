{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wepilo-marketing",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Old /features addresses go to the Worker first so it can 301 them to /product.
    "run_worker_first": ["/features", "/features/*"]
  },
  "routes": [{ "pattern": "aboutwepilo.basilpot.com", "custom_domain": true }],
  "vars": {
    "DASHBOARD_URL": "https://wepilo.basilpot.com"
  }
}
