{
  "name": "wepilo-dashboard",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": { "STOREFRONT_URL": "https://wepilo-storefront-production.tejghartikshetri.workers.dev" },
  "routes": [{ "pattern": "wepilo.basilpot.com", "custom_domain": true }]
}
