    "jose": "^6.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.2",
    "wrangler": "^4.106.0"
  }
